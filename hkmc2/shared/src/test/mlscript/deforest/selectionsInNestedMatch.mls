//│ Call(Ref(member:AA),List(Arg(false,Lit(IntLit(2)))))@3@inst__tsni --> Ref(x)@inst_0_tsni@AA
//│ -------------- executing -------------
//│ = 2
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<


fun c(x, y) = if x is
  AA then
    if y is
      A then x.x
c(AA(2), A)
