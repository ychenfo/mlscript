fun c(x) = if x is
  AA then
    if A is
      A then x.x
c(AA(2))
//│ = 2
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ ---------- deforest summary ----------
//│ Ref(member:A)@1@inst_2_tsni --> Ref($scrut)@inst_2_tsni@A
