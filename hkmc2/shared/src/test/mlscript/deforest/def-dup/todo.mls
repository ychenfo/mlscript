// TODO: no duplication of `p(1)` or `p(2)` is helpful in this case
// but duplicating `f2(two)` AND `p(2)` is helpful...
// ctor─┬─►pRes1─┬──►f1Consumer
//      │        └──►f2Consumer
//      │                ▲
//      └─►pRes2 ────────┘
:deforestDup
fun p(x) = A(x)
let one = p(1)
let two = p(2)
fun f1(p) = if p is A(a) then a + 1
fun f2(p) = if p is A(b) then b + 2
f1(one) + f2(one) + f2(two)
//│ = 9
//│ one = A(1)
//│ two = A(2)
//│ duplication chances:
//│ 	Call(Ref(member:p),List(Arg(false,Lit(IntLit(2))))) <-- dup --> member:p_duplicated@1008
//│ =========
