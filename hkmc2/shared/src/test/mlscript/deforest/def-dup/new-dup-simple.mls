fun to(n, acc) = if n == 0 then acc else to(n - 1, n :: acc)
fun f1(ls1, acc) = if ls1 is
  Nil then acc
  h :: t then f1(t, acc + h)
fun f2(ls2, acc) = if ls2 is
  Nil then acc
  hh :: tt then f2(tt, acc + hh + 1)
f1(to(4, Nil), 0) + f2(to(5, Nil), 0) + f1(to(6, Nil), 0)
