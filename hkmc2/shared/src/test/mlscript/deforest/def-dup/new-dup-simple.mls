//│ Call(Ref(member:A),List(Arg(None,Ref($tmp))))@4@inst__tsni --> Ref(x)@inst_1_tsni@A
//│ -------------- executing -------------
//│ = B(0)
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<


:deforest
fun localFuse(x) = if A(x) is
  A(y) then B(y)
if localFuse(3) is
  B(a) then a
localFuse(4)
//│ = B(4)
