:deforest
fun inner(y, z) = if y is
  B then z
fun dtor(x) = if x is
  A then inner(B(4), x.x)
dtor(A(B(0)))
//│ = B(0)
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
