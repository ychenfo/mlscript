:deforest
fun p(x) = A(x)
fun wrap1(x) = p(x)
fun wrap(x) = wrap1(x)
fun f1(a1) = if a1 is A then 1
fun f2(a2) = if a2 is A then 2
f1(wrap(1)) + f2(wrap(2))
