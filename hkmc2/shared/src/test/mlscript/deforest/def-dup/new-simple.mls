// for selection filter
:deforest
fun f(x) = if x is
  A then g1(x.x)
  B then g2(x.x)
fun g1(y1) = if y1 is
  A then 0
fun g2(y2) = if y2 is
  A then 1
fun apply(f) =
  let inner = A(0)
  f(A(inner))
apply(f)
