:deforestDup
// calls to `to` should be able to be duplicated
fun to(n) =
  if n > 0 then
    let m = n - 1
    n :: to(m)
  else
    Nil
fun f1(ls1) = if ls1 is
  h :: t then h + f1(t)
  Nil then 2
fun f2(ls2) = if ls2 is
  h :: t then h + f2(t)
  Nil then 3
fun f3(ls3) = if ls3 is
  h :: t then h + f3(t)
  Nil then 4
fun f4(ls4) = if ls4 is
  h :: t then h + f4(t)
  Nil then 5
f1(to(4)) + f2(to(5)) + f3(to(6)) + f4(to(7))
//│ = 88
//│ duplication chances:
//│ 	Call(Ref(member:to),List(Arg(false,Lit(IntLit(4))))) <-- dup --> member:to
//│ 	Call(Ref(member:to),List(Arg(false,Lit(IntLit(5))))) <-- dup --> member:to
//│ 	Call(Ref(member:to),List(Arg(false,Lit(IntLit(6))))) <-- dup --> member:to
//│ No fusion opportunity


:deforestDup
fun to(n) =
  if n > 0 then
    let m = n - 1
    n :: to(m)
  else
    Nil
fun f1(ls1) = if ls1 is
  h :: t then h + f1(t)
  Nil then 2
f1(to(4))
//│ = 12
//│ duplication chances:
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ = 12
//│ 2 fusion opportunities:
//│ 	Cons --match--> `if ls1 is ...`
//│ 	Nil --match--> `if ls1 is ...`
