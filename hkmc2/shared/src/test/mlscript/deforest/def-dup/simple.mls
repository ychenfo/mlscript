:js
:deforest

//│ No fusion opportunity

data class A(x)

data class (::) Cons(h, t)
object Nil


// `A(1)` is in the definition of `test`, but
// no duplication is helpful
fun test() =
  let p = A(1)
  let a = if p is
    A(x) then x
  let b = if p is
    A(x) then x
  a + b
test() + test()
//│ = 4
//│ No fusion opportunity


// two calls to `to` should be able to be duplicated
fun to(n) = if n > 0 then n :: to(n - 1) else Nil
fun f1(ls) = if ls is
  h :: t then h
  Nil then 2
fun f2(ls) = if ls is
  h :: t then h + 1
  Nil then 3
f1(to(4)) + f2(to(5))
//│ = 10
//│ No fusion opportunity


