fun map(ls, f) = if ls is
  Nil then Nil
  h :: t then f(h) :: map(t, f)
fun succ(x) = x + 1
fun double(x) = x * 2
fun test() =
  map(map(1 :: 2 :: Nil, succ), double)
test()
