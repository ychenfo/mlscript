fun to(n) = if n > 0 then n :: to(n - 1) else Nil
fun f1(ls) = if ls is
  h :: t then h
  Nil then 2
fun f2(ls) = if ls is
  h :: t then h + 1
  Nil then 3
fun wrap(n) = to(n)
f1(wrap(4)) + f2(wrap(5))
