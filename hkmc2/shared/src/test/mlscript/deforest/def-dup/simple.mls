fun to(n) =
  if n > 0 then
    let m = n - 1
    n :: to(m)
  else
    Nil
fun f1(ls1) = if ls1 is
  h :: t then h + f1(t)
  Nil then 2
f1(to(4))
//│ = 12



:deforestDup
fun map(ls, f) = if ls is
  Nil then Nil
  h :: t then f(h) :: map(t, f)
fun succ(x) = x + 1
fun double(x) = x * 2
fun test() =
  map(map(1 :: 2 :: Nil, succ), double)
test()
