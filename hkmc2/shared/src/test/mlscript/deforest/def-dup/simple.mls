// for this example it will be a pity to not duplicate `id(A(1))` and `id(A(2))`,
// although the ctors are not located in the definition of `id`
// A(1)─┬─►id1Res───►f1Consumer
//      │                      
// A(2)─┴─►id2Res───►f2Consumer
:deforestDup
fun id(x) = x
fun f1(a) = if a is A(i) then i
fun f2(a) = if a is A(i) then i + 1
f1(id(A(1))) + f2(id(A(2)))
