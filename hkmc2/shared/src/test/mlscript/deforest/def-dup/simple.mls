//│ No fusion opportunity

data class A(x)

data class (::) Cons(h, t)
object Nil

:deforestDup
// `A(1)` is in the definition of `test`, but
// no duplication is helpful
fun test() =
  let p = A(1)
  let a = if p is
    A(x) then x
  let b = if p is
    A(x) then x
  a + b
test() + test()
//│ = 4
//│ duplication chances:
//│ No fusion opportunity

:deforestDup
fun p(d) = A(3)
fun c1(x) = if x is A then 1
fun c2(x) = if x is A then 2
fun test() =
  c1(p(1)) + c2(p(2))
test()
//│ = 3
//│ duplication chances:
//│ 	Call(Ref(member:p),List(Arg(false,Lit(IntLit(1))))) <-- dup --> member:p
//│ No fusion opportunity


