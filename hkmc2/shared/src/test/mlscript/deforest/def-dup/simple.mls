fun p(x) = A(x)
fun g1(b) = if b then p(1) else p(2)
fun wrap(b) = g1(b)
fun g2(b) = if b then p(3) else p(4)
fun f1(p) = if p is A(a) then a + 1
fun f2(p) = if p is A(b) then b + 2
f1(wrap(true)) + f2(g2(false))
