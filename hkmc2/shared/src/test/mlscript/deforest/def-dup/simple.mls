fun p(x) = A(x)
let one = p(1)
let two = p(2)
fun f1(p) = if p is A(a) then a + 1
fun f2(p) = if p is A(b) then b + 2
fun f3(p) = if p is A(c) then c + 3
f1(one) + f2(one) + f3(two)
//│ = 10
