fun test(k, ls) =
  fun lscomp(ls) = if ls is
    h :: t then (h + 1) :: lscomp(t)
    Nil then Nil
  if k is
    A then lscomp(ls)
    B then Nil
test(A, 1 :: 2 :: 3 :: Nil)
//│ = Cons(2, Cons(3, Cons(4, Nil)))
