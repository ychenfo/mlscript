//│ = 13
//│ 4 fusion opportunities:
//│ 	AA --match--> `if scrut is ...`
//│ 	AA --match--> `if scrut is ...`
//│ 	AA --match--> `if x is ...`
//│ 	BB --match--> `if tmp is ...`
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<



fun test(n, p, q) =
  n +
  if AA(0) is
    AA then
      let k = if p is
        AA(x) then x
      if q is
        AA(y) then k + y
test(3, AA(2), AA(3)) + test(3, AA(2), AA(3))
