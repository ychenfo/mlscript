//│ 	AA --match--> `if x is ...`
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<


fun c(x, y) = if x is
  AA then
    let t = if y is
      A then 2 + x.x
    t + x.x
fun c2(y) = if y is A then 3
let y = A
c(AA(2), y) + c2(y)
//│ = 9
//│ y = A
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
