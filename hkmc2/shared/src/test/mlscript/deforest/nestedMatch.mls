fun f(x, y) =
  let tmp = BB(y + 1)
  if tmp is
    BB then
      let m = if x is
        AA then
          if AA(2) is
            AA(yf) then yf
      if AA(3) is
        AA then m + tmp.x
let aa = AA(3)
f(aa, 3) + f(aa, 4)
//│ = 13
//│ aa = AA(3)
