:js
:deforest

//│ No fusion opportunity
object A
object B
object C
data class AA(x)
data class BB(x)
data class CC(x)

object Nil
data class Cons(h, t)

object None
data class Some(x)


fun f(x, y) =
  let t = if x is
    AA(a) then
      let m = if a is
        AA(x) then x
      m + 9
    BB(b) then b
  t + y
fun g(x) = if x is
  AA then 0
let a = AA(AA(3))
f(a, 2) + g(a) + f(BB(3), 2) + f(AA(AA(4)), 5)
//│ = 37
//│ a = AA(AA(3))
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ = 37
//│ 2 fusion opportunities:
//│ 	AA --match--> `if a is ...`
//│ 	AA --match--> `if a is ...`
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<



fun f(x, y) =
  let n = if x is
    AA(a) then
      if a is
        AA(m) then m
  n + 2 + y
f(AA(AA(3)), 9) + f(AA(AA(4)), 10)
//│ = 30
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
