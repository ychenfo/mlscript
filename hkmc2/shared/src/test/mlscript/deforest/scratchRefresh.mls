:js
:deforest

data class A(x)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<


:sir
module M with
  fun g(y) = y + 1
  fun f(x) = if x is A(y) then g(y) else 0
M.f(A(1))
