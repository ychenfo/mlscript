fun count(c, xs) = if xs is
  h :: t then count(c + 1, t)
  Nil then c
fun rev(a, ys) = if ys is
  h :: t then rev(h :: a, t)
  Nil then a
count(0, rev(Nil, 1 :: 2 :: Nil))
