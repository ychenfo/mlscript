fun enumFromTo(a, b) = if a < b then a :: enumFromTo(a + 1, b) else Nil
fun map(f, ls) =
  (if ls is
    Nil then f => Nil
    h :: t then f => f(h) :: map(f, t)
  )(f)
map(x => x + 4, enumFromTo(1, 4))
