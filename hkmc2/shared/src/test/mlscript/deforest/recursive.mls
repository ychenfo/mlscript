fun c(x) = if x is
  T(n, l, r) then T of
    if n is
      A then 0
      B then 1
    c(l)
    c(r)
  L then L
c(T(A, T(B, L, L), T(A, L, L)))
//│ = T(0, T(1, L, L), T(0, L, L))
