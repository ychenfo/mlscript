fun mk(n) = if n < 0 then Nil else n :: mk(n - 1)
fun map(f, ls_map) = if ls_map is
  h :: t then f(h) :: map(f, t)
  Nil then Nil
fun map1(f, ls_map1) = if ls_map1 is
  h :: t then f(h) :: map1(f, t)
  Nil then Nil
fun incr(x) = x + 1
fun double(x) = x * 2
fun test(ls) = map1(incr, map(double, ls))
test(id(mk(5)))
