data class Pair(a, b)
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ Not deforestable: Only support top-level module definitions now
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<


fun pair_up(xs) =
  if xs is
    x :: xss then
      if xss is
        y :: xs then Pair(x, y) :: pair_up(xs)
        else Nil
    else Nil
fun mk(n) = if n > 0 then (n - 1) :: n :: (n + 1) :: mk(n - 1) else Nil
fun test(x) = pair_up(mk(x))
test(4)
//│ = Cons(Pair(3, 4), Cons(Pair(5, 2), Cons(Pair(3, 4), Cons(Pair(1, 2), Cons(Pair(3, 0), Cons(Pair(1, 2), Nil))))))
