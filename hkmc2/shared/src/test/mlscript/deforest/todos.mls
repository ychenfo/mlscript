:js
:deforest

object A
object B
object C
class AA(x)
class BB(x)

object Nil
class Cons(h, t)

object None
class Some(x)



// TODO: how to keep track of the correct s.x
:sjs
module Test with
  fun f1(a) = if a is
    A then 1
    B then 2
    C then 3
  fun f2(a) = if a is
    A then 4
    B then 5
    C then 6
  let s = if true then AA(A) else BB(B)
  if s is
    AA then f1(s.x)
    BB then f2(s.x)
