// since `x.x` is considered as being consumed
// at two places,the inner match is not fused
:sjs
fun f(x) = if x is
  AA then if x.x is
    AA then x.x.x
f(AA(AA(3)))
//│ JS (unsanitized):
//│ let f, tmp, tmp1;
//│ f = function f(x) {
