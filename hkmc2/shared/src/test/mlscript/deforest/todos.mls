// TODO: the computation of `t + 5 * 4 - 3 + 2 - 1` is still duplicated...
:sjs
fun test(x) =
  let t = if x is
    AA(AA(AA(a))) then a
    else 4
  t + 5 * 4 - 3 + 2 - 1
fun f(a) = if a is
  AA(AA) then 0
let p = AA(AA(AA(10)))
test(p) + f(p) + test(AA(AA(AA(10)))) + test(B)
