:js
:deforest

object A
object B
object C
class AA(val x)
class BB(val x)
class CC(val x)

object Nil
class Cons(val h, val t)

object None
class Some(val x)



// TODO: keep track of the equality between `Test.#s` and scrut.
// The `s` in `if s is ...` is actually `Test.#s`,
// and `s.x`s in branches are actually `Test.#s.x`.
// This causes that `Test.#s` has 3 consumption sites,
// and the `A` or `B` in `Test.#s.x` cannot get the branch-specific information
// to be considered as having only 1 consumption site.
:sjs
module Test with
  fun f1(a) = if a is
    A then 1
    B then 2
    C then 3
  fun f2(a) = if a is
    A then 4
    B then 5
    C then 6
  let s = if true then AA(A) else BB(B)
  if s is
    AA then f1(s.x)
    BB then f2(s.x)
//│ JS (unsanitized):
