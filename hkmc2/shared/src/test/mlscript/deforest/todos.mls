// if `Test.#s.x` is always consumed by `f`
// the `A` and `B` can be fused, but not the outer `AA` or `BB`
:sjs
module Test with
  fun f(a) = if a is
    A then 1
    B then 2
    C then 3
  let s = if true then AA(A) else BB(B)
  if s is
    AA then f(s.x)
    BB then f(s.x)
