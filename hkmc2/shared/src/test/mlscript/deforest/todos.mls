// NOTE: if we replace `x.x` first, the nested pat mat will not be fused...
// we can perform the replacing of `x.x` and rewriting at the same time, but
// then there will be a non-existing free var `x`
:sjs
fun c(x) = if x is
  AA then
    if A is
      A then x.x
c(AA(2))
