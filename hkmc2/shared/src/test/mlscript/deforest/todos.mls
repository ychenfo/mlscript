//│     if (scrut instanceof AA1.class) {
//│       return x.x.x
//│     } else {
//│       throw new globalThis.Error("match error");
//│     }
//│   } else {
//│     throw new globalThis.Error("match error");
//│   }
//│ };
//│ tmp = AA1(3);
//│ tmp1 = AA1(tmp);
