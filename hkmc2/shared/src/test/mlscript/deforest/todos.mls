// NOTE: if we replace `x.x` first, the nested pat mat will not be fused...
// currently this is fine because `x.x` is not considered to be inside the matching arm...
:sjs
fun c(x) = if x is
  AA then
    if A is
      A then x.x
c(AA(2))
