// FIXME: fused matches should always be considered as in tail positions
:fixme
:sjs
fun test(x, y, z, i) =
  let k = if x is
    AA(a) then
      let m = if y is
        AA(a1) then a1 + i
        BB(b2) then b2 - i
      let n = if z is
        BB(a2) then a2 - i
      m + n
  k + i
