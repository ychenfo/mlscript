// FIXME: the `Cons` branch does use `a`, but should also take that argument
:sjs
fun enumFromTo(a, b) = if a < b then Cons(a, enumFromTo(a + 1, b)) else Nil
fun last(ls, a) = if ls is
  Nil then a
  Cons(h, t) then last(t, Some(h))
last(enumFromTo(1, 10), None)
//│ JS (unsanitized):
//│ let last, enumFromTo, tmp1;
