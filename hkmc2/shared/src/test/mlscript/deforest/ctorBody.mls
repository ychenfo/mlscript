//│   let tmp;
//│   set tmp = Cons⁰(1, Nil⁰);
//│   return B²(tmp)
//│ };
//│ define B³ as class B⁴ {
//│   private val xs¹;
//│   constructor B²(xs) {
//│     let arg$Cons$0$, tmp;
//│     set B⁴.this.xs¹ = xs;
//│     match B⁴.this.xs¹
//│       Cons¹ =>
//│         set arg$Cons$0$ = B⁴.this.xs¹.h⁰;
//│         do B⁴.this.xs¹.t⁰;
//│         set tmp = arg$Cons$0$;
//│         end
//│       else
//│         set tmp = 0;
//│         end
//│     do Predef⁰.print⁰(tmp);
//│     end
//│   }
//│ };
//│ return mk¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
