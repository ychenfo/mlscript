// simple free var example
:sjs
fun enumFromTo(a, b) = if a < b then Cons(a, enumFromTo(a + 1, b)) else Nil
fun map(f, ls) =
  if ls is
    Nil then Nil
    Cons(h, t) then Cons(f(h), map(f, t))
map(x => x + 4, enumFromTo(1, 4))
//│ JS (unsanitized):
//│ let enumFromTo2, map1, tmp8;
//│ enumFromTo2 = function enumFromTo(a, b) {
//│   let scrut, tmp9, tmp10;
//│   scrut = a < b;
//│   if (scrut === true) {
//│     tmp9 = a + 1;
//│     tmp10 = enumFromTo2(tmp9, b);
//│     return Cons1(a, tmp10)
//│   } else {
//│     return Nil1
