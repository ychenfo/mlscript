:deforest
object Nil
class Cons(h, t)

:sjs
:deforest
fun enumFromTo(a, b) = if a < b then Cons(a, enumFromTo(a + 1, b)) else Nil
fun map(ls) = if ls is
  Nil then Nil
  Cons(h, t) then Cons(h + 4, map(t))
map(enumFromTo(1, 4))
