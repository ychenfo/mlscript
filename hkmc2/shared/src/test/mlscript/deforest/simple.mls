object A
object B
class AA(x)
class BB(x)

:sjs
:deforest
fun test() =
  let x = if true then A else B
  if x is
    A then 1
    B then 2
test()
//│ JS (unsanitized):
//│ function test() {
//│   let x, scrut, tmp;
//│   scrut = true;
//│   if (scrut) {
//│     tmp = globalThis.A;
//│   } else {
//│     tmp = globalThis.B;
//│   }
//│   x = tmp;
//│   if (x instanceof globalThis.A.class) {
//│     return 1;
//│   } else {
//│     if (x instanceof globalThis.B.class) {
//│       return 2;
//│     } else {
//│       throw new globalThis.Error("match error");
//│     }
//│   }
//│ }
//│ this.test()
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ ==== JS (deforested): ====
//│ function test() {
//│   let x, scrut, tmp;
//│   scrut = true;
//│   if (scrut) {
//│     tmp = 1;
//│   } else {
//│     tmp = 2;
//│   }
//│   x = tmp;
//│   return x;
//│ }
//│ this.test()
//│ = 1
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<
//│ = 1


