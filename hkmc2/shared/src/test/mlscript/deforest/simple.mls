fun enumFromTo(a, b) = if a < b then Cons(a, enumFromTo(a + 1, b)) else Nil
fun sum(ls) = if ls is
  Nil then 0
  Cons(h, t) then h + sum(t)
sum(enumFromTo(1,10))
