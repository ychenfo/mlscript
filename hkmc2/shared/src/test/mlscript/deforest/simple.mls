// `x.x` is successfully fused
:sjs
fun f1(a) = if a is
  A then 1
  B then 2
  C then 3
fun f2(a) = if a is
  A then 4
  B then 5
  C then 6
fun test() =
  let x = if true then AA(A) else BB(B)
  if x is
    AA then f1(x.x)
    BB then f2(x.x)
test()
