// technically ill-typed, so `AA(3)` (which flows to `z`) is not fused
fun test(x, y, z) = if x is
  AA(a) then
    let m = if y is
      AA(a1) then a1 + z
    let n = if z is
      AA(a2) then a2 - z
    m + n
test(AA(1), AA(2), AA(3))
//│ = "2AA(3)NaN"
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ = "2AA(3)NaN"
//│ 2 fusion opportunities:
//│ 	AA --match--> `if x is ...`
//│ 	AA --match--> `if y is ...`
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<


fun test(x) =
  let t = id of
    if x is
      AA(a) then a
      BB(a) then a
  t(123).c + 5 * 4 - 3 + 2 - 1
let p = if true then AA(CCC) else BB(CCC)
test(p)
//│ = 141
//│ p = AA([function CCC])
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ = 141
//│ 2 fusion opportunities:
//│ 	AA --match--> `if x is ...`
//│ 	BB --match--> `if x is ...`
//│ <<<<<<<<<<<<<<<<<<<<<<<<<<< Deforestation <<<<<<<<<<<<<<<<<<<<<<<<<<<


fun test(x, y) =
  let t =
    if y is CCC then
      if x is
        AA(a) then a
        BB(a) then a
  t(123).c + 5 * 4 - 3 + 2 - 1
let p = if true then AA(CCC) else BB(CCC)
test(p, id(CCC(123)))
//│ = 141
//│ p = AA([function CCC])
//│ >>>>>>>>>>>>>>>>>>>>>>>>>>> Deforestation >>>>>>>>>>>>>>>>>>>>>>>>>>>
//│ = 141
