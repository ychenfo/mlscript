//│ No fusion opportunity

object A
object B
object C
class AA(val aa)
class BB(val bb)
class AAA(val x, val y)
class BBB(val x, val y)
class CCC(val c)
object None
class Some(val value)

:sjs
fun test() =
  let x = if true then A else B
  if x is
    A then 1
    B then 2
test()
//│ JS (unsanitized):
//│ let test;
