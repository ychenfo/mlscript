// simple free var example
:sjs
fun enumFromTo(a, b) = if a < b then Cons(a, enumFromTo(a + 1, b)) else Nil
fun map(f, ls) =
  if ls is
    Nil then Nil
    Cons(h, t) then Cons(f(h), map(f, t))
map(x => x + 4, enumFromTo(1, 4))
