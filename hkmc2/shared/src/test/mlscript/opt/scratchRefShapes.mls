:js


// the IR shape of each kind of reference to a local definition
:lot
fun f(y) =
  fun g(a) = a
  fun k(q: C) = q.x
  data class C(x) with
    val w = x
    fun m(z) = x + w + z
  object O with
    val foo = 1
    fun bar() = foo
  let c = C(1)
  let d = new C(2)
  let s = c.x + c.w + c.m(1) + O.foo + O.bar() + g(y) + k(d)
  if c is C(p) then p + s else 0
f(1)
