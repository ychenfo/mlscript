// * LIMIT: `a` is only used by the second call, which this same run removes; that use still counts.
:soir
:noInline
:expect 1
private fun work(x) = x + 1
fun k(x) =
  let a = work(x)
  let b = work(a)
  x
k(1)
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > eliminable: Call(member:work²‹term:work³›, [[a⁰]]) @ <root>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define work² as fun work³(x) {
//│   return +⁰(x, 1)
//│ };
//│ define k⁰ as fun k¹(x) { do work³(x); return x };
//│ return k¹(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// * A call that assigns a variable of an enclosing scope stays, although its result is unused.
:soir
:noInline
:expect 1
fun count() =
  let n = 0
  fun bump() = set n = n + 1
  bump()
  n
count()
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define count⁰ as fun count¹() {
//│   let bump, n;
//│   define bump as fun bump⁰() {
//│     let tmp;
//│     set tmp = +⁰(n, 1);
//│     set n = tmp;
//│     return runtime⁰.Unit⁰
//│   };
//│   set n = 0;
//│   do bump⁰();
//│   return n
//│ };
//│ return count¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// * A method of a module nested in a class can be called from a later block, so its result is used.
:soir
:noInline
class O(val v) with
  module M with
    fun get() = v + 1
let o = new O(1)
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define O⁰ as class O² {
//│   val v⁰;
//│   constructor O¹(v) {
//│     define v⁰ as val v¹ = v;
//│     define M⁰ as class M¹
//│     module M² {
//│       method get⁰ = fun get¹() { return +⁰(O².this.v¹, 1) }
//│     };
//│     end
//│   }
//│ };
//│ set o⁰ = new O²(1);
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ o = O(1)

:expect 2
o.M.get()
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ = 2


// * Lifting turns the reassigned closure into a field of a capture object, read through a class parameter;
// * the argument of the call through that field is used.
:lift
:expect 6
fun foo() =
  let f = ()
  set f = n =>
    if n <= 0 then 0
    else n + f(n - 1)
  f(3)
foo()
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ = 6


// * `viaPut` writes a cell held by a top-level binding only through `put`; its result is unused, but the call stays.
:soir
:noInline
:expect 1
private val cell = new mut C(0)
private fun put(n) =
  set cell.C#x = n
  n
private fun viaPut(n) = put(n)
fun main() =
  let r = viaPut(1)
  cell.C#x
main()
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ @private
//│ define put⁰ as fun put¹(n) {
//│   set cell⁰.x⁰ = n;
//│   return n
//│ };
//│ @private
//│ define viaPut⁰ as fun viaPut¹(n) {
//│   return put¹(n)
//│ };
//│ define main⁰ as fun main¹() {
//│   do viaPut¹(1);
//│   return cell⁰.x⁰
//│ };
//│ set tmp = new mut C⁰(0);
//│ @private
//│ define cell¹ as val cell⁰ = tmp;
//│ return main¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ cell = C(1)


// * Each use of `app` is analyzed separately: the copy for `a` calls a pure callback and drops the call,
// * the copy for `b` keeps it.
:flowBasedOpt debugDead poly
:soir
:noInline
private fun app(k, x) =
  let r = k(x)
  0
fun a() = app(x => x + 1, 1)
fun b() = app(x => print(x), 2)
a()
b()
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > eliminable: Call(builtin:+⁰, [[x¹, 1]]) @ a³
//│ dead-call-elim > eliminable: Call(builtin:+⁰, [[x¹, 1]]) @ a⁰
//│ dead-call-elim > eliminable: Call(k², [[x²]]) @ a³.app⁰
//│ dead-call-elim > eliminable: Call(k², [[x²]]) @ a⁰.app⁰
//│ dead-call-elim > eliminable: Call(member:app¹‹term:app²›, [[member:lambda⁰‹term:lambda¹›, 1]]) @ a³
//│ dead-call-elim > eliminable: Call(member:a¹‹term:a²›, [[]]) @ <root>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let a_app$app;
//│ @private @private
//│ define a_app$app as fun a_app$app⁰(k, x) {
//│   return 0
//│ };
//│ @private
//│ define app⁰ as fun app¹(k, x) {
//│   do k(x);
//│   return 0
//│ };
//│ define a⁰ as fun a¹() {
//│   let lambda;
//│   define lambda as fun lambda⁰(x) {
//│     return undefined
//│   };
//│   return a_app$app⁰(lambda⁰, 1)
//│ };
//│ define b⁰ as fun b¹() {
//│   let lambda;
//│   define lambda as fun lambda¹(x) {
//│     return Predef⁰.print⁰(x)
//│   };
//│   return app¹(lambda¹, 2)
//│ };
//│ return b¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ = 0


