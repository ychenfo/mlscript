// * The result of `work` only goes into a parameter that dead-parameter elimination removes,
// * so the call is removed in the same run.
:soir
:noInline
:expect 0
private fun work(x) = x + 1
private fun ignore(y) = 0
fun f(x) = ignore(work(x))
f(1)
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > eliminable: Call(builtin:+⁰, [[x¹, 1]]) @ <root>
//│ dead-call-elim > eliminable: Call(member:work⁰‹term:work¹›, [[x⁰]]) @ <root>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define work⁰ as fun work¹(x) {
//│   return undefined
//│ };
//│ @private
//│ define ignore⁰ as fun ignore¹() {
//│   return 0
//│ };
//│ define f⁰ as fun f¹(x) { return ignore¹() };
//│ return f¹(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// * A call that only writes a cell its callee created itself has no effect visible to the caller.
:soir
:noInline
:expect 1
private fun local(n) =
  let o = new mut C(0)
  set o.C#x = n
  o.C#x
fun g(n) =
  let r = local(n)
  n
g(1)
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > eliminable: Call(member:local⁰‹term:local¹›, [[n⁰]]) @ <root>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > eliminable: {0} of Instantiate(true, member:C⁰‹class:C¹›, [[0]]) @ <root>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define local⁰ as fun local¹(n) {
//│   let o;
//│   set o = new mut C⁰(undefined);
//│   set o.x⁰ = n;
//│   return o.x⁰
//│ };
//│ define g⁰ as fun g¹(n) { return n };
//│ return g¹(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// * A call that writes a cell its caller passed in stays.
:soir
:noInline
:expect 1
private fun write(o, n) =
  set o.C#x = n
  n
fun h() =
  let o = new mut C(0)
  let r = write(o, 1)
  o.C#x
h()
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define write⁰ as fun write¹(o, n) {
//│   set o.x⁰ = n;
//│   return n
//│ };
//│ define h⁰ as fun h¹() { let o; set o = new mut C⁰(0); do write¹(o, 1); return o.x⁰ };
//│ return h¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


