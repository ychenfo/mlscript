// * The closure returned by `f` is called twice: it is not one-shot, so `f` is not expanded.
:soir
:noInline
:expect 9
private fun work(x) = x + 1
private fun f(x) =
  let c = work(x)
  y => c + y
fun main() =
  let g = f(1)
  g(2) + g(3)
main()
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ infer-affine > >>> inferred affine >>>
//│ infer-affine > <<< inferred affine <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let lambda, lambda$;
//│ @inline @private
//│ define lambda$ as fun lambda$⁰(c)(y) {
//│   return lambda⁰(c, y)
//│ };
//│ @private
//│ define lambda as fun lambda⁰(c, y) {
//│   return +⁰(c, y)
//│ };
//│ @private
//│ define work⁰ as fun work¹(x) {
//│   return +⁰(x, 1)
//│ };
//│ @private
//│ define f⁰ as fun f¹(x) {
//│   let c;
//│   set c = work¹(x);
//│   return lambda$⁰(c)
//│ };
//│ define main⁰ as fun main¹() {
//│   let g, tmp, tmp1;
//│   set g = f¹(1);
//│   set tmp = g(2);
//│   set tmp1 = g(3);
//│   return +⁰(tmp, tmp1)
//│ };
//│ return main¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 9


// * The same `f`, whose result is only ever applied right away: it is expanded.
:soir
:noInline
:expect 4
private fun work(x) = x + 1
private fun f(x) =
  let c = work(x)
  y => c + y
fun main() = f(1)(2)
main()
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > f²#0 @ <root>: [1, 1]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ infer-affine > >>> inferred affine >>>
//│ infer-affine > lambda$¹#1 @ <root>
//│ infer-affine > <<< inferred affine <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let lambda, lambda$;
//│ @inline @private
//│ define lambda$ as fun lambda$¹(c)(y) {
//│   return lambda¹(c, y)
//│ };
//│ @private
//│ define lambda as fun lambda¹(c, y) {
//│   return +⁰(c, y)
//│ };
//│ @private
//│ define work² as fun work³(x) {
//│   return +⁰(x, 1)
//│ };
//│ @private
//│ define f² as fun f³(x)(eta$0$0) {
//│   let c;
//│   set c = work³(x);
//│   return lambda$¹(c)(eta$0$0)
//│ };
//│ define main² as fun main³() { return f³(1)(2) };
//│ return main³()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4


// * The closure goes to unknown code, which may call it any number of times: no expansion.
:soir
:noInline
private fun work(x) = x + 1
private fun f(x) =
  let c = work(x)
  y => c + y
fun main() = unknown(f(1))
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ infer-affine > >>> inferred affine >>>
//│ infer-affine > <<< inferred affine <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
