:js
:lift
:flowBasedOpt debugEta debugAffine


class C(val x)
declare fun unknown(o): Anything
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ infer-affine > >>> inferred affine >>>
