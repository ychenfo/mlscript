:js


// a dead ctor in a poly copy whose arg mentions a nested defn the copy refreshes
:flowBasedOpt debugDce poly
:soir
:noInline
:noOpt
:expect 13
class A(a)
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(k, x) =
  fun g(y) = k(y)
  let d = new A(g)
  let h = g(x)
  h(2)
f(k1, 1) + f(k2, 5)
