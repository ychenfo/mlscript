//│     }
//│   };
//│   set c = new C⁰(x);
//│   set tmp2 = c.get﹖();
//│   set scrut = isC⁰(c);
//│   match scrut
//│     true =>
//│       return g⁰(tmp2)(2)
//│     else
//│       return 0
//│   end
//│ };
//│ @affine(1)
//│ define k1⁰ as fun k1¹(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ define k2⁰ as fun k2¹(a)(b) {
//│   return *⁰(a, b)
//│ };
