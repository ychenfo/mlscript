:js


// the copy of `f` refreshes its nested class, which `isC` refers to before it is defined
:flowBasedOpt poly
:soir
:noInline
:expect 13
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(k, x) =
  fun isC(o) = o is C
  fun g(y) = k(y)
  class C(a) with
    fun get() = a
  let c = new C(x)
  let h = g(c.get())
  if isC(c) then h(2) else 0
f(k1, 1) + f(k2, 5)
