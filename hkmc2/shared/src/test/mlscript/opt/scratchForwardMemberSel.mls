:js


// a member of a nested object selected in a copy before the object's definition
:flowBasedOpt poly
:soir
:noInline
:noOpt
:expect 24
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(k, x) =
  fun g(y) = k(y + O.foo)
  object O with
    val foo = x
  let h = g(x)
  h(2)
f(k1, 1) + f(k2, 5)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, f$f;
//│ define f$f as fun f$f⁰(k, x) {
//│   let g, O, h;
//│   define g as fun g⁰(y)(eta$0$0) {
//│     let tmp2;
//│     set tmp2 = +⁰(y, O⁰.foo⁰);
//│     return k(tmp2)(eta$0$0)
//│   };
//│   define O as object O⁰ {
//│     val foo¹;
//│     constructor() {
//│       define foo¹ as val foo⁰ = x;
//│       end
//│     }
//│   };
//│   set h = g⁰(x);
//│   return h(2)
//│ };
//│ @affine(1)
//│ define k1⁰ as fun k1¹(a)(b) {
//│   return +⁰(a, b)
//│ };
//│ define k2⁰ as fun k2¹(a)(b) {
//│   return *⁰(a, b)
//│ };
//│ define f⁰ as fun f¹(k, x) {
//│   let g, O, h;
//│   define g as fun g¹(y) {
//│     let tmp2;
//│     set tmp2 = +⁰(y, O¹.foo²);
//│     return k(tmp2)
//│   };
//│   define O as object O¹ {
//│     val foo³;
//│     constructor() {
//│       define foo³ as val foo² = x;
//│       end
//│     }
//│   };
//│   set h = g¹(x);
//│   return h(2)
//│ };
//│ set tmp = f$f⁰(k1¹, 1);
//│ set tmp1 = f¹(k2¹, 5);
//│ return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 24


// a member selected through a typed param in a copy before the class definition
:fixme
:flowBasedOpt poly
:soir
:noInline
:noOpt
:expect 24
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(kk, x) =
  fun g(y) = kk(y)
  fun k(q: C) = q.x
  data class C(x)
  let h = g(k(C(x)) + x)
  h(2)
f(k1, 1) + f(k2, 5)
