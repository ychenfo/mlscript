// a class pattern in a copy before the class definition
:fixme
:flowBasedOpt poly
:soir
:noInline
:noOpt
:expect 24
@affine(1) fun k1(a)(b) = a + b
fun k2(a)(b) = a * b
fun f(kk, x) =
  fun g(y) = kk(y)
  fun mt(q) = if q is C(v) then v else 0
  data class C(x)
  let h = g(mt(C(x)) + x)
  h(2)
f(k1, 1) + f(k2, 5)
