// * A function inside a cell handed to a callback can be called with an older cell and store it
// * in `h`'s local: the cell's contents must also count at the negative sign, so that the
// * function's parameter counts at the positive one.
:expect 5
private fun k(r)(c) =
  set r.C#x = c
  0
private fun g(q)(w) =
  let f = w.C#x
  f(q)
  0
private fun h(gg) =
  let r = new mut C(new mut C(0))
  gg(new mut C(k(r)))
  let q = r.C#x
  set q.C#x = 5
  0
private fun m(q) = h(g(q))
fun main() =
  let o = new mut C(0)
  m(o)
  o.C#x
main()
//│ flow-analysis > >>> effect-analysis results >>>
