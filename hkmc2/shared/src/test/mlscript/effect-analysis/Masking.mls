// * Mutual recursion: each function answers only for its own parameters. The cell is `g`'s input
// * but not `f`'s, since `f` creates a new one every time it is called.
// * (`:noTailRec` here and below: the tail-call pass would merge `f` and `g` into one function.)
:noTailRec
:expect 0
private fun f(n) = g(new mut C(0), n)
private fun g(o, n) =
  set o.C#x = n
  if n > 0 then f(n - 1) else n
f(2)
