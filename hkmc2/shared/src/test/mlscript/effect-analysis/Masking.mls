// * LIMIT: the write only touches this call's cell, but the cell comes back through the callback's
// * result, so its name counts as visible and the write stays, although eta would be safe here.
private fun f(k) =
  let o = new mut C(0)
  set o.C#x = 1
  k(o)
f(x => x)
