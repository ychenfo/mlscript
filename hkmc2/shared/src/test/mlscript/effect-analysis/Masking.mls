// * A later call writes the cell an earlier call created. That cell reaches the write through
// * `f`'s own parameter, which is why `f` needs no view of `g`'s parameters.
:noTailRec
:expect 0
private fun f(prev, n) =
  let o = new mut C(n)
  g(o, prev, n)
private fun g(o, prev, n) =
  if n < 2 then set prev.C#x = n else ()
  if n > 0 then f(o, n - 1) else 0
f(0, 2)
