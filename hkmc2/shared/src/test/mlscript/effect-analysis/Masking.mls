// * Mutual recursion: the whole group is copied per use, and each copy of each function
// * still answers only for its own parameters.
:noTailRec
fun main() = f(2)
private fun f(n) = g(new mut C(0), n)
private fun g(o, n) =
  set o.C#x = n
  if n > 0 then f(n - 1) else n
