// * A cell that `f` only passes on is still `f`'s input, so both functions keep the write,
// * and the caller that created the cell masks it.
:noTailRec
:expect 0
private fun f(o, n) = if n > 0 then g(o, n - 1) else n
private fun g(o, n) =
  set o.C#x = n
  f(o, n)
fun main() =
  let o = new mut C(5)
  f(o, 2)
  o.C#x
main()
