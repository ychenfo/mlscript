// * LIMIT: with one copy of `f`, a callback that ignores the cell is merged with one that returns it.
private fun f(k) =
  let o = new mut C(0)
  set o.C#x = 1
  k(o)
fun a() = f(x => x)
fun b() = f(x => 0)
