// * The caller that created the cell masks it across the group.
:noTailRec
private fun f(o, n) = if n > 0 then g(o, n - 1) else n
private fun g(o, n) =
  set o.C#x = n
  f(o, n)
fun main() =
  let o = new mut C(5)
  f(o, 2)
  o.C#x
