// * A cell handed to a callback can come back holding an older cell: `h` only reaches `q`
// * through the contents of its own cell, so those contents must count at the positive sign.
:expect 1
private fun fill(prev)(x) =
  set x.C#x = prev
  0
private fun h(cb) =
  let r = new mut C(new mut C(0))
  cb(r)
  let t = r.C#x
  set t.C#x = 1
  0
private fun m(q) = h(fill(q))
fun main() =
  let o = new mut C(0)
  m(o)
  o.C#x
main()
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function fill⁰#0 @ <root> -> Pure
//│ flow-analysis > function fill⁰#1 @ <root> -> UnsafeEta
//│ flow-analysis > function h⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function main⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function m⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call cb⁰@result⁴#0 @ <root> -> UnsafeEta
//│ flow-analysis > call fill⁰@result³#0 @ <root> -> Pure
//│ flow-analysis > call h⁰@result²#0 @ <root> -> UnsafeEta
//│ flow-analysis > call main⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call m⁰@result¹#0 @ <root> -> UnsafeEta
