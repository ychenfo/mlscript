// * The callback runs in `g` on a cell created in `f`. `f` holds the same callback,
// * so the cell coming back through it is visible to `f` as well.
:noTailRec
private fun f(k, n) =
  let o = new mut C(0)
  set o.C#x = n
  g(k, o, n)
private fun g(k, o, n) =
  if n > 0 then f(k, n - 1) else k(o)
fun a() = f(x => x, 1)
fun b() = f(x => 0, 1)
