// * `f` and `g` see the captured cell through each other.
// * `main` is unsafe only because defining a local function always counts as an effect.
:noTailRec
:expect 0
fun main() =
  let o = new mut C(0)
  fun f(n) = g(n)
  fun g(n) =
    set o.C#x = n
    if n > 0 then f(n - 1) else n
  f(1)
main()
