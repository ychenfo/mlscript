// * The callback can return a cell from an earlier call of `f`, so the write must stay.
:expect 1
private fun f(k, n) =
  let o = new mut C(0)
  let t = k(o)
  set t.C#x = n
  @affine(0) (z) => o
fun main() =
  let o = f(x => x, 5)(0)
  let h = f(x => o, 1)
  let v = o.C#x
  h(0)
  v
main()
