// * The group is copied for each caller, so only the copy whose callback returns the cell keeps the write.
:noTailRec
private fun f(k, n) =
  let o = new mut C(0)
  set o.C#x = n
  g(k, o, n)
private fun g(k, o, n) =
  if n > 0 then f(k, n - 1) else k(o)
fun a() = f(x => x, 1)
fun b() = f(x => 0, 1)
