// * (a) closure stored through a temporary, as the lifter does
:noSanityCheck
:expect 42
data class MyState[S, A](r: S -> [S, A])
private fun myRunState(m, s) = if m is MyState(f) then f(s)
private fun bindBody(m, f, s) = if myRunState(m, s) is [s_, a] then myRunState(f(a), s_)
private fun bindL(m, f)(s) = bindBody(m, f, s)
private fun myBind(m, f) =
  let h = bindL(m, f)
  MyState(h)
private fun returnBody(a, s) = [s, a]
private fun returnL(a)(s) = returnBody(a, s)
private fun myReturn(a) =
  let h = returnL(a)
  MyState(h)
data class Some(x)
private fun lookup(t) = Some(t)
private fun myMaybe(f, x) = if x is Some(x) then f(x)
private fun idL(x) = x
private fun lookupL(env) = [env, myMaybe(idL, lookup(env))]
private fun lookupVar() = MyState(lookupL)
private fun evalL(t) = eval(t)
private fun eval(n) = if n is
  0 then myBind(lookupVar(), evalL)
  else myReturn(n)
private fun main() = if myRunState(eval(0), 42) is [s, a] then a
main()
