class C(val x)
class D(val x, mut val y)
declare fun unknown(o): Anything
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > <<< effect-analysis results <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<


// * Reading a field of a frozen object is pure.
:expect 3
@affine(1) fun add(t)(y) = t + y
private fun read(o: C) = add(o.x)
fun f(n) = read(new C(n))
f(1)(2)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function add⁰#0 @ <root> -> Pure
//│ flow-analysis > function add⁰#1 @ <root> -> Pure
//│ flow-analysis > function f⁰#0 @ <root> -> Pure
//│ flow-analysis > function read⁰#0 @ <root> -> Pure
//│ flow-analysis > call +⁰@result⁴#0 @ <root> -> Pure
//│ flow-analysis > call add⁰@result³#0 @ <root> -> Pure
//│ flow-analysis > call baseCall¹@result⁰#0 @ <root> -> Pure
//│ flow-analysis > call f⁰@result¹#0 @ <root> -> Pure
//│ flow-analysis > call read⁰@result²#0 @ <root> -> Pure
//│ flow-analysis > <<< effect-analysis results <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > f⁰#0 @ <root>: [1, 1]
//│ eta-expansion > read⁰#0 @ <root>: [1, 1]
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ = 3


// * So is reading a field of a mutable object that is never written.
:expect 3
@affine(1) fun add(t)(y) = t + y
private fun read(o: C) = add(o.x)
fun f(n) = read(new mut C(n))
f(1)(2)
