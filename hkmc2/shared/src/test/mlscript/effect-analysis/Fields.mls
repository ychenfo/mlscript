// * ...but only the `mut val` fields of a frozen one.
@affine(1) fun add(t)(y) = t + y
private fun readX(o: D) = add(o.x)
private fun readY(o: D) = add(o.y)
private fun g(o: D) =
  unknown(o)
  [readX(o), readY(o)]
fun f(n) = g(new D(n, n))
