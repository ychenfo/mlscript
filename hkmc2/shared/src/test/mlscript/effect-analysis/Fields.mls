// * A write anywhere makes the reads of that field effects, even the reads that run before it.
:expect 1
@affine(1) fun add(t)(y) = t + y
private fun read(o: C) = add(o.x)
private fun bump(o: C) = set o.x = o.x + 1
private fun g(o: C) =
  let h = read(o)
  bump(o)
  h(0)
fun f(n) = g(new mut C(n))
f(1)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function add⁰#0 @ <root> -> Pure
//│ flow-analysis > function add⁰#1 @ <root> -> Pure
//│ flow-analysis > function bump⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function f⁰#0 @ <root> -> Pure
//│ flow-analysis > function g⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function read⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call +⁰@result⁵#0 @ <root> -> Pure
//│ flow-analysis > call +⁰@result⁷#0 @ <root> -> Pure
//│ flow-analysis > call add⁰@result⁶#0 @ <root> -> Pure
//│ flow-analysis > call bump⁰@result³#0 @ <root> -> UnsafeEta
//│ flow-analysis > call f⁰@result⁰#0 @ <root> -> Pure
//│ flow-analysis > call g⁰@result¹#0 @ <root> -> UnsafeEta
//│ flow-analysis > call h⁰@result²#0 @ <root> -> Pure
//│ flow-analysis > call read⁰@result⁴#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ = 1


// * Writing a field is an effect.
@affine(1) fun add(t)(y) = t + y
private fun write(o: C, n) =
  set o.x = n
  add(n)
fun f(n) = write(new mut C(0), n)
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function add⁰#0 @ <root> -> Pure
//│ flow-analysis > function add⁰#1 @ <root> -> Pure
//│ flow-analysis > function f⁰#0 @ <root> -> Pure
//│ flow-analysis > function write⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call +⁰@result²#0 @ <root> -> Pure
//│ flow-analysis > call add⁰@result¹#0 @ <root> -> Pure
//│ flow-analysis > call write⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > f⁰#0 @ <root>: [1, 1]
//│ eta-expansion > <<< eta-expansion targets shapes <<<


// * Writing a field of an object allocated by the same function is an effect too: there is no masking.
@affine(1) fun add(t)(y) = t + y
fun f(n) =
  let o = new mut C(0)
  set o.x = n
  add(o.x)
