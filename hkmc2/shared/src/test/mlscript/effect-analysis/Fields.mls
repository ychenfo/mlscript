// * Writing one field does not make the reads of another field effects.
:expect 3
@affine(1) fun add(t)(y) = t + y
private fun readX(o: D) = add(o.x)
private fun g(o: D) =
  set o.y = 0
  readX(o)
fun f(n) = g(new mut D(n, n))
f(1)(2)
