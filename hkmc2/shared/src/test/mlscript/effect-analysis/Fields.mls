// * A value written into a field flows to the reads of that field,
// * so calling the function read from it observes the written function's effect.
class A(val f)
private fun swap(o: A) =
  set o.f = () =>
    print("called")
    2
  if o is A(f) then f
private fun call(k) =
  let t = k()
  @affine(0) (y) => t + y
fun main() =
  let h = call(swap(new mut A(() => 1)))
  print("before")
  h(0)
main()
//│ flow-analysis > >>> effect-analysis results >>>
//│ flow-analysis > function call⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function lambda$⁰#0 @ <root> -> Pure
//│ flow-analysis > function lambda$⁰#1 @ <root> -> Pure
//│ flow-analysis > function lambda²#0 @ <root> -> Pure
//│ flow-analysis > function lambda¹#0 @ <root> -> Pure
//│ flow-analysis > function lambda⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function main⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > function swap⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call +⁰@result⁸#0 @ <root> -> Pure
//│ flow-analysis > call call⁰@result³#0 @ <root> -> UnsafeEta
//│ flow-analysis > call h⁰@result¹#0 @ <root> -> Pure
//│ flow-analysis > call k⁰@result⁶#0 @ <root> -> UnsafeEta
//│ flow-analysis > call lambda$⁰@result⁵#0 @ <root> -> Pure
//│ flow-analysis > call lambda¹@result⁹#0 @ <root> -> Pure
//│ flow-analysis > call main⁰@result⁰#0 @ <root> -> UnsafeEta
//│ flow-analysis > call print@result²#0 @ <root> -> UnsafeEta
//│ flow-analysis > call print@result⁷#0 @ <root> -> UnsafeEta
//│ flow-analysis > call swap⁰@result⁴#0 @ <root> -> UnsafeEta
//│ flow-analysis > <<< effect-analysis results <<<
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ > called
//│ > before
//│ = 2




private fun f(c: C) = 
  let cap = c.x
  @affine(0) () => cap
f(new C(4))
