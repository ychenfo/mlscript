:noSanityCheck
:expect 42
data class MyState[S, A](r: S -> [S, A])
fun myRunState(m, s) = if m is MyState(f) then f(s)
fun myBind(m, f) = MyState(s => if myRunState(m, s) is [s_, a] then myRunState(f(a), s_))
fun myReturn(a) = MyState(s => [s, a])
data class Some(x)
fun lookup(t) = Some(t)
fun myMaybe(f, x) = if x is Some(x) then f(x)
fun lookupVar() = MyState(env => [env, myMaybe(x => x, lookup(env))])
fun eval(n) = if n is
  0 then myBind(lookupVar(), t => eval(t))
  else myReturn(n)
fun main() = if myRunState(eval(0), 42) is [s, a] then a
main()
