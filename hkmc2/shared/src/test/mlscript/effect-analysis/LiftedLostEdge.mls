fun myRunState(m, s) = if m is MyState(f) then f(s)
fun myBind(m, f) = MyState(s => if myRunState(m, s) is [s_, a] then myRunState(f(a), s_))
fun myReturn(a) = MyState(s => [s, a])
data class Some(x)
fun lookup(t) = Some(t)
