:fixme
:expect 42
fun returnBody(a, s) = [s, a]
fun returnL(a)(s) = returnBody(a, s)
fun eval(n) = if n is
  0 then s => returnL(s)(s)
  else returnL(n)
fun main() = if eval(0)(42) is [s, a] then a
main()
