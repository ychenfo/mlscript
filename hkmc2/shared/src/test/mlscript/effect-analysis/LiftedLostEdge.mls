:noSanityCheck
:expect 42
data class MyState[S, A](r: S -> [S, A])
fun myRunState(m, s) = if m is MyState(f) then f(s)
fun bindBody(m, f, s) = if myRunState(m, s) is [s_, a] then myRunState(f(a), s_)
fun bindL(m, f)(s) = bindBody(m, f, s)
fun myBind(m, f) = MyState(bindL(m, f))
fun returnBody(a, s) = [s, a]
fun returnL(a)(s) = returnBody(a, s)
fun myReturn(a) = MyState(returnL(a))
data class Some(x)
fun lookup(t) = Some(t)
fun myMaybe(f, x) = if x is Some(x) then f(x)
fun idL(x) = x
fun lookupL(env) = [env, myMaybe(idL, lookup(env))]
fun lookupVar() = MyState(lookupL)
fun evalL(t) = eval(t)
fun eval(n) = if n is
  0 then myBind(lookupVar(), evalL)
  else myReturn(n)
fun main() = if myRunState(eval(0), 42) is [s, a] then a
main()
