:js


// * A state-monad program reduced from nofib `lambda`. The lifter turns `env => ...` into a root function
// * that `lookupVar` refers to only under a cast. In poly mode, the call graph used to miss that reference,
// * so `lookupVar` was analyzed before the lambda had a scheme, its `MyState` held no function, and
// * dead-parameter elimination dropped the state argument of `myRunState` (the program returned `undefined`).
#config(liftDefns: Some(LiftDefns), flowBasedOpt: Some(FlowBasedOpt(mono: false, debugDpe: true, debugDead: true)))
// #config(liftDefns: None, flowBasedOpt: Some(FlowBasedOpt(mono: false, debugDpe: true, debugDead: true)))
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ dead-call-elim > >>> dead-call-elim results >>>
//│ dead-call-elim > <<< dead-call-elim results <<<
//│ dead-branch-elim > >>> dead-branch-elim results >>>
//│ dead-branch-elim > <<< dead-branch-elim results <<<
//│ dead-lambda-elim > >>> dead-lambda-elim results >>>
//│ dead-lambda-elim > <<< dead-lambda-elim results <<<
//│ dead-field-elim > >>> dead-field-elim results >>>
//│ dead-field-elim > <<< dead-field-elim results <<<
//│ dead-read-elim > >>> dead-read-elim results >>>
//│ dead-read-elim > <<< dead-read-elim results <<<

:expect 42
:sir
:soir
data class MyState[S, A](r: S -> [S, A])
private fun myRunState(m, s) = if m is MyState(f) then f(s)
private fun myBind(m, f) = MyState(s => if myRunState(m, s) is [s_, a] then myRunState(f(a), s_))
private fun myReturn(a) = MyState(s => [s, a])
data class Some(x)
private fun lookup(t) = Some(t)
private fun myMaybe(f, x) = if x is Some(x) then f(x)
private fun lookupVar() = MyState(env => [env, myMaybe(x => x, lookup(env))])
private fun eval(n) = if n is
  0 then myBind(lookupVar(), t => eval(t))
  else myReturn(n)
private fun main() = if myRunState(eval(0), 42) is [s, a] then a
main()
