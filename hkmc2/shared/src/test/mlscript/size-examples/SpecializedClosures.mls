:js


// * a closure-returning helper with two kinds of uses: one applies the closure right away,
// * the other passes it on and calls it twice; mono must keep returning the closure for both uses,
// * poly eta-expands the first use's copy (see the eta-expansion log), which then needs no closure


:soir
:flowBasedOpt mono debugEta
private fun mk(n) =
  let a = n * 2 + n * 3 + n * 4
  x => x * a + x * n + a * n
private fun twice(h, x) = h(h(x))
fun main(y) = [mk(y)(1), twice(mk(y + 1), 3)]
//│ eta-expansion > >>> eta-expansion targets shapes >>>
//│ eta-expansion > <<< eta-expansion targets shapes <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define mk⁰ as fun mk¹(n) {
//│   let a, tmp, tmp1, tmp2, tmp3, lambda;
//│   set tmp = *⁰(n, 2);
//│   set tmp1 = *⁰(n, 3);
//│   set tmp2 = +⁰(tmp, tmp1);
//│   set tmp3 = *⁰(n, 4);
//│   set a = +⁰(tmp2, tmp3);
//│   @private
//│   define lambda as fun lambda⁰(x) {
//│     let tmp4, tmp5, tmp6, tmp7;
//│     set tmp4 = *⁰(x, a);
//│     set tmp5 = *⁰(x, n);
//│     set tmp6 = +⁰(tmp4, tmp5);
//│     set tmp7 = *⁰(a, n);
//│     return +⁰(tmp6, tmp7)
//│   };
//│   return lambda⁰
//│ };
//│ @private
//│ define twice⁰ as fun twice¹(h, x) {
//│   let tmp;
//│   set tmp = h(x);
//│   return h(tmp)
//│ };
//│ define main⁰ as fun main¹(y) {
//│   let baseCall, tmp, tmp1, tmp2, inlinedVal, tmp3;
//│   set baseCall = mk¹(y);
//│   set tmp = baseCall(1);
//│   set tmp1 = +⁰(y, 1);
//│   set tmp2 = mk¹(tmp1);
//│   set tmp3 = tmp2(3);
//│   set inlinedVal = tmp2(tmp3);
//│   return [tmp, inlinedVal]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [19, 1956]
main(1)
//│ = [19, 1956]


