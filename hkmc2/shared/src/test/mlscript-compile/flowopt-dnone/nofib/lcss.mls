#lang(0.3.x)

import "./NofibPrelude.mls"
open NofibPrelude

// port changes from nofib/lcss.mls: self-contained except for the shared NofibPrelude (the list functions it
// used are copied in); no type annotations





module lcss with ...

// list functions copied from NofibPrelude

private fun compose(f, g) = x => f(g(x))

private fun snd(x) = if x is [f, s] then s

private fun reverse(l) =
  fun r(l', l) = if l is x :: xs then r(x :: l', xs) else l'
  r(Nil, l)

private fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

private fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

private fun enumFromThenTo(a, t, b) = if a <= b then a :: enumFromThenTo(t, 2 * t - a, b) else Nil

private fun leave(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then ls
    else leave(n - 1, t)

private fun take(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then Nil
    else h :: take(n - 1, t)

private fun zip(xs, ys) = if xs is
  x :: xs and ys is y :: ys then [x, y] :: zip(xs, ys)
  else Nil

private fun inList(x, ls) = if ls is
  h :: t and
    x === h then true
    else inList(x, t)
  Nil then false




private fun algb2(x, k0j1, k1j1, yss) = if yss is
  Nil then Nil
  [y, k0j] :: ys then
    let kjcurr = if x == y then k0j1 + 1 else max(k1j1, k0j)
    [y, kjcurr] :: algb2(x, k0j, kjcurr, ys)

private fun algb1(xss, yss) = if xss is
  Nil then map(snd, yss)
  x :: xs then algb1(xs, algb2(x, 0, 0, yss))

private fun algb(xs, ys) =
  fun listcomp_fun(listcomp_fun_para) = if listcomp_fun_para is
      listcomp_fun_ls_h :: listcomp_fun_ls_t then [listcomp_fun_ls_h, 0] :: listcomp_fun(listcomp_fun_ls_t)
      Nil then Nil

  0 :: algb1(xs, listcomp_fun(ys))


private fun findk(k, km, m, ls) = if ls is
  Nil then km
  [x,y] :: xys then if (x + y) >= m then findk(k+1, k, x+y, xys) else findk(k+1, km, m, xys)

private fun algc(m, n, xs, ys) = if
  ys is Nil then x => x
  xs is
    x :: Nil and
      inList(x, ys) then t => x :: t
      else x => x
  else
    let m2 = intDiv(m, 2)
    let xs1 = take(m2, xs)
    let xs2 = leave(m2, xs)
    let l1 = algb(xs1, ys)
    let l2 = reverse(algb(reverse(xs2), reverse(ys)))
    let k = findk(0, 0, -1, zip(l1, l2))
    compose(algc(m2, k, xs1, take(k, ys)), (algc(m-m2, n-k, xs2, leave(k, ys))))

private fun lcss(xs, ys) = algc(listLen(xs), listLen(ys), xs, ys)(Nil)

private fun lcssMain(a, b ,c, d, e, f) = lcss(enumFromThenTo(a,b,c), enumFromThenTo(d,e,f))

private fun testLCSS_nofib(d) = lcssMain(1,2,60,30,31,90)



fun main() = testLCSS_nofib(0).toString()

