#lang(0.3.x)

import "./NofibPrelude.mls"
import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
open NofibPrelude

// port changes from nofib/rsa.mls: self-contained except for the shared NofibPrelude (the list functions it used
// are copied in); no type annotations; `main` takes the contents of the input file (rsa.faststdin) instead of
// reading it into a top-level value


module rsa with ...

// list functions copied from NofibPrelude

private fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

private fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

private fun leave(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then ls
    else leave(n - 1, t)

private fun take(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then Nil
    else h :: take(n - 1, t)

private fun (+:) append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)

private fun concat(ls) = if ls is
  Nil then Nil
  x :: xs then append(x, concat(xs))

private fun foldl(f, a, xs) = if xs is
  Nil then a
  h :: t then foldl(f, f(a, h), t)




private fun z_of_int(x) = globalThis.BigInt(x)
private fun string_of_z(x) = nofibStringToList(x + "")
private fun z_add(x, y) = x + y
private fun z_mul(x, y) = x * y
private fun z_sub(x, y) = x - y
private fun z_div(x, y) = x / y
private fun z_mod(x, y) = x % y
private fun z_equal(x, y) = x === y
private fun z_sqr(x) = x * x
private fun int_if_char(c) = c.codePointAt(0)

val const0 = z_of_int(0)
//│ const0 = 0

val const31 = z_of_int(31)
//│ const31 = 31

val const1 = z_of_int(1)
//│ const1 = 1

val const2 = z_of_int(2)
//│ const2 = 2

val const128 = z_of_int(128)
//│ const128 = 128

private fun hash(str) = foldl of
  (acc, c) => z_add(z_of_int(int_if_char(c)), z_mul(acc, const31))
  const0
  str

private fun and_(ls) = if ls is
  Nil then true
  h :: t and
    h then and_(t)
    else false

private fun unlines(ls) = concat of map(l => l +: ("\n" :: Nil), ls)

private fun even(a) = z_mod(a, const2) === const0

private fun code(ls) = foldl of
  (x, y) => z_add(z_mul(const128, x), z_of_int(int_if_char(y)))
  const0
  ls

private fun collect(n, xs) = if
  n === 0 then Nil
  xs is Nil then Nil
  else take(n, xs) :: collect(n, leave(n, xs))

private fun size(n) = intDiv(listLen(string_of_z(n)) * 47, 100)

private fun encrypt(n, e, s) = unlines of map of
  c => string_of_z(power(e, n, code(c)))
  collect(size(n), s)
private fun power(n, m, x) = if
  z_equal(n, const0) then const1
  even(n) then z_mod(z_sqr(power(z_div(n, const2), m, x)), m)
  else z_mod(z_mul(x, power(z_sub(n, const1), m, x)), m)

private fun testRsa_nofib(input) = hash(encrypt(
  z_of_int("2036450659413645137870851576872812267542175329986469156678671505255564383842535488743101632280716717779536712424613501441720195827856504007305662157107"),
  z_of_int("387784473137902876992546516170169092918207676456888779623592396031349415024943784869634893342729620092877891356118467738167515879252473323905128540213"),
  nofibStringToList(input)
))

fun main(input) = testRsa_nofib(input)

