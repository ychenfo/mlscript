#lang(0.3.x)

import "./NofibPrelude.mls"
import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
open NofibPrelude

// port changes from nofib/constraints.mls: self-contained except for the shared NofibPrelude (the list functions
// it used are copied in); no type annotations; plain classes and objects instead of the class hierarchies

module constraints with ...

// list functions copied from NofibPrelude

private fun snd(x) = if x is [f, s] then s

private fun fst(x) = if x is [f, s] then f

private fun head(l) = if l is h :: t then h

private fun tail(l) = if l is h :: t then t

private fun reverse(l) =
  fun r(l', l) = if l is x :: xs then r(x :: l', xs) else l'
  r(Nil, l)

private fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

private fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

private fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

private fun inList(x, ls) = if ls is
  h :: t and
    x === h then true
    else inList(x, t)
  Nil then false

private fun notElem(x, ls) = not(inList(x, ls))

private fun (+:) append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)

private fun concat(ls) = if ls is
  Nil then Nil
  x :: xs then append(x, concat(xs))

private fun filter(f, ls) = if ls is
  Nil then Nil
  h :: t and
    f(h) then h :: filter(f, t)
    else filter(f, t)

private fun all(p, ls) = if ls is
  Nil then true
  h :: t and
    p(h) then all(p, t)
    else false

private fun foldl(f, a, xs) = if xs is
  Nil then a
  h :: t then foldl(f, f(a, h), t)

private fun nubBy(eq, ls) = if ls is
  Nil then Nil
  h :: t then h :: nubBy(eq, filter(y => not(eq(h, y)), t))

private fun zipWith(f, xss, yss) = if
  xss is x :: xs and yss is y :: ys then f(x, y) :: zipWith(f, xs, ys)
  else Nil

private fun deleteBy(eq, x, ys) = if ys is
  Nil then Nil
  y :: ys and
    eq(x, y) then ys
    else y :: deleteBy(eq, x, ys)

private fun unionBy(eq, xs, ys) = append(xs, foldl((acc, y) => deleteBy(eq, y, acc), nubBy(eq, ys), xs))

private fun union(xs, ys) = unionBy((x, y) => x == y, xs, ys)

private fun atIndex(i, ls) = if ls is
  h :: t and
    i == 0 then h
    else atIndex(i - 1, t)

private fun null_(ls) = if ls is
  Nil then true
  else false




// -- Figure 1. CSPs in Haskell.
data class Assign(varr, value)

data class CSP(vars, vals, rel)

//│ ————————————————————————————————————————————————————————————————————————————————
private fun qsort(le, ls, r) = if ls is
  Nil then r
  x :: Nil then x :: r
  x :: xs then qpart(le, x, xs, Nil, Nil, r)

private fun qpart(le, x, ls, rlt, rge, r) = if ls is
  Nil then rqsort(le, rlt, x :: rqsort(le, rge, r))
  y :: ys and
    le(x, y) then qpart(le, x, ys, rlt, y :: rge, r)
    else qpart(le, x, ys, y :: rlt, rge, r)

private fun rqsort(le, ls, r) = if ls is
  Nil then r
  x :: Nil then x :: r
  x :: xs then rqpart(le, x, xs, Nil, Nil, r)

private fun rqpart(le, x, ls, rle, rgt, r) = if ls is
  Nil then rqsort(le, rle, x :: qsort(le, rgt, r))
  y :: ys and
    le(y, x) then rqpart(le, x, ys, y :: rle, rgt, r)
    else rqpart(le, x, ys, rle, y :: rgt, r)
//│ ————————————————————————————————————————————————————————————————————————————————

private fun level(a) = if a is Assign(v, _) then v

private fun value(a) = if a is Assign(_, v) then v

private fun maxLevel(ls) = if ls is
  Nil then 0
  Assign(v, _) :: t then v

private fun complete(csp, s) = if csp is CSP(v, _, _) then maxLevel(s) == v

private fun safe(as1, as2) = if as1 is Assign(i, m) and as2 is Assign(j, n) then not(m == n) and not(abs(i - j) == abs(m - n))

private fun queens(n) = CSP(n, n, safe)

// -- Figure 2.  Trees in Haskell.
data class Node(lab, children)

private fun label(n) = if n is Node(l, _) then l

private fun mapTree(f, n) = if n is Node(l, c) then Node(f(l), map((x => mapTree(f, x)), c))

private fun foldTree(f, n) = if n is Node(l, c) then f(l, map((x => foldTree(f, x)), c))

private fun filterTree(p, t) =
  fun f1(a, cs) = Node(a, filter(x => p(label(x)), cs))
  foldTree(f1, t)

private fun prune(p, t) = filterTree(x => not(p(x)), t)

private fun leaves(t) = if t is
  Node(leaf, Nil) then leaf :: Nil
  Node(_, cs) then concat(map(leaves, cs))

private fun initTree(f, x) = Node(x, map(y => initTree(f, y), f(x)))

// -- Figure 3.  Simple backtracking solver for CSPs.
private fun mkTree(csp) = if csp is CSP(vars, vals, rel) then
  fun next(ss) =
    if maxLevel(ss) < vars then
      fun lscomp1(ls) = if ls is
        Nil then Nil
        j :: t1 then
          (Assign(maxLevel(ss) + 1, j) :: ss) :: lscomp1(t1)
      lscomp1(enumFromTo(1, vals))
    else
      Nil

  initTree(next, Nil)


private fun earliestInconsistency(csp, aas) = if csp is CSP(vars, vals, rel) and aas is
  Nil then None
  a :: as_ and filter(x => not(rel(a, x)), reverse(as_)) is
    Nil then None
    b :: _ then Some([level(a), level(b)])

private fun labelInconsistencies(csp, t) =
  fun f2(s) = [s, earliestInconsistency(csp, s)]

  mapTree(f2, t)


private fun btsolver0(csp) =
  filter of
    x => complete(csp, x)
    leaves of
      mapTree of
        fst
        prune of
          x => not(snd(x) === None)
          labelInconsistencies(csp, mkTree(csp))

// -- Figure 6. Conflict-directed solving of CSPs.
data class Known(vs)
object Unknown

private fun knownConflict(c) = if c is
  Known(a :: as_) then true
  else false

private fun knownSolution(c) = if c is
  Known(Nil) then true
  else false

private fun checkComplete(csp, s) = if complete(csp, s) then Known(Nil) else Unknown

private fun search(labeler, csp) =
  map of
    fst
    filter of
      x => knownSolution(snd(x))
      leaves of prune of
        x => knownConflict(snd(x))
        labeler(csp, mkTree(csp))

private fun bt(csp, t) =
  fun f3(s) = [s, (if earliestInconsistency(csp, s) is Some([a, b]) then Known(a :: b :: Nil) else checkComplete(csp, s))]

  mapTree(f3, t)

// -- Figure 8. Backmarking.

private fun emptyTable(csp) = if csp is CSP(vars, vals, rel) then
  fun lscomp1(ls) = if ls is
    Nil then Nil
    n :: t1 then
      fun lscomp2(ls) = if ls is
        Nil then Nil
        m :: t2 then
          Unknown :: lscomp2(t2)
      lscomp2(enumFromTo(1, vals)) :: lscomp1(t1)

  Nil :: lscomp1(enumFromTo(1, vars))


private fun fillTable(s, csp, tbl) = if s is
  Nil then tbl
  Assign(var_, val_) :: as_ and csp is CSP(vars, vals, rel) then
    fun f4(cs, varval) = if varval is [varr, vall] and
      cs === Unknown and not(rel(Assign(var_, val_), Assign(varr, vall))) then Known(var_ :: varr :: Nil)
      else cs

    fun lscomp1(ls) = if ls is
      Nil then Nil
      varrr :: t1 then
        fun lscomp2(ls) = if ls is
          Nil then Nil
          valll :: t2 then [varrr, valll] :: lscomp2(t2)
        lscomp2(enumFromTo(1, vals)) :: lscomp1(t1)

    zipWith((x, y) => zipWith(f4, x, y), tbl, lscomp1(enumFromTo(var_ + 1, vars)))


private fun lookupCache(csp, t) =
  fun f5(csp, tp) = if tp is
    [Nil, tbl] then [[Nil, Unknown], tbl]
    [a :: as_, tbl] then
      let tableEntry = atIndex(value(a) - 1, head(tbl))
      let cs = if tableEntry === Unknown then checkComplete(csp, a :: as_) else tableEntry
      [[a :: as_, cs], tbl]

  mapTree(x => f5(csp, x), t)


private fun cacheChecks(csp, tbl, n) = if n is Node(s, cs) then
  Node([s, tbl], map(x => cacheChecks(csp, fillTable(s, csp, tail(tbl)), x), cs))

private fun bm(csp, t) = mapTree(fst, lookupCache(csp, cacheChecks(csp, emptyTable(csp), t)))

// -- Figure 10. Conflict-directed backjumping.
private fun combine(ls, acc) = if ls is
  Nil then acc
  [s, Known(cs)] :: css and
    notElem(maxLevel(s), cs) then cs
    else combine(css, union(cs, acc))

private fun bj_(csp, t) =
  fun f7(tp2, chs) = if tp2 is
    [a, Known(cs)] then Node([a, Known(cs)], chs)
    [a, Unknown] and
      let cs_ = Known(combine(map(label, chs), Nil))
      knownConflict(cs_) then Node([a, cs_], Nil)
      else Node([a, cs_], chs)

  foldTree(f7, t)


private fun bj(csp, t) =
  fun f6(tp2, chs) = if tp2 is
    [a, Known(cs)] then Node([a, Known(cs)], chs)
    [a, Unknown] then Node([a, Known(combine(map(label, chs), Nil))], chs)

  foldTree(f6, t)


private fun bjbt(csp, t) = bj(csp, bt(csp, t))

private fun bjbt_(csp, t) = bj_(csp, bt(csp, t))

// -- Figure 11. Forward checking.
private fun collect(ls) = if ls is
  Nil then Nil
  Known(cs) :: css then union(cs, collect(css))

private fun domainWipeout(csp, t) = if csp is CSP(vars, vals, rel) then
  fun f8(tp2) = if tp2 is [[as_, cs], tbl] then
    let wipedDomains = 
      fun lscomp1(ls) = if ls is
        Nil then Nil
        vs :: t1 and
          all(knownConflict, vs) then vs :: lscomp1(t1)
          else lscomp1(t1)
      lscomp1(tbl)
    let cs_ = if null_(wipedDomains) then cs else Known(collect(head(wipedDomains)))
    [as_, cs_]

  mapTree(f8, t)


private fun fc(csp, t) = domainWipeout(csp, lookupCache(csp, cacheChecks(csp, emptyTable(csp), t)))

private fun try_(n, algorithm) = listLen(search(algorithm, queens(n)))

private fun testConstraints_nofib(n) = map(x => try_(n, x), bt :: bm :: bjbt :: bjbt_ :: fc :: Nil)


fun main() = testConstraints_nofib(6).toString()