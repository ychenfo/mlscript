#lang(0.3.x)

import "./NofibPrelude.mls"
open NofibPrelude

// port changes from nofib/cryptarithm1.mls: self-contained except for the shared NofibPrelude (the list
// functions it used are copied in); no type annotations; a smaller puzzle: the original solves
// THIRTY + 5 * TWELVE = NINETY over all ten digits (3628800 permutations), and `permutations` builds its
// result with one stack frame per element, which overflows the stack; this one solves
// ONE + 2 * FOUR = NINE (also 1 + 2 * 4 = 9) over the digits 0 to 6 (5040 permutations, one solution)


module cryptarithm1 with ...

// list functions copied from NofibPrelude

private fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

private fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

private fun take(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then Nil
    else h :: take(n - 1, t)

private fun filter(f, ls) = if ls is
  Nil then Nil
  h :: t and
    f(h) then h :: filter(f, t)
    else filter(f, t)




private fun expand(a, b, c, d, e, f) = f + (e*10) + (d*100) + (c*1000) + (b*10000) + (a*100000)

private fun condition(onefuri) = if onefuri is
  o :: n :: e :: f :: u :: r :: i :: Nil then
    (expand(0, 0, 0, o, n, e) + 2 * expand(0, 0, f, o, u, r)) == expand(0, 0, n, i, n, e)

private fun addj(j, ls) = if ls is
  Nil then (j :: Nil) :: Nil
  k :: ks then
    fun lscomp(p1) = if p1 is
      Nil then Nil
      h1 :: t1 then (k :: h1) :: lscomp(t1)

    (j :: (k :: ks)) :: lscomp(addj(j, ks))

private fun permutations(ls) = if ls is
  Nil then Nil :: Nil
  j :: js then
    fun lscomp1(p1) = if p1 is
      Nil then Nil
      pjs :: t1 then
        fun lscomp2(p2) = if p2 is
          Nil then lscomp1(t1)
          r :: t2 then r :: lscomp2(t2)
        lscomp2(addj(j, pjs))

    lscomp1(permutations(js))

private fun testCryptarithm_nofib(n) = 
  map((i => let p0 = take(7, enumFromTo(0, 9 + i)) in filter(condition, permutations(p0))), enumFromTo(1, n))


fun main() = testCryptarithm_nofib(1)


