#lang(0.3.x)

import "./NofibPrelude.mls"
import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
open NofibPrelude

open annotations { tailrec }

// port changes from nofib/puzzle.mls: self-contained except for the shared NofibPrelude (the list functions it
// used are copied in); no type annotations; plain classes and objects instead of the class hierarchies; the
// `throw` on a wrong argument count is left out (impossible case)

module puzzle with ...

// list functions copied from NofibPrelude

private fun reverse(l) =
  fun r(l', l) = if l is x :: xs then r(x :: l', xs) else l'
  r(Nil, l)

private fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

private fun (+:) append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)

private fun concat(ls) = if ls is
  Nil then Nil
  x :: xs then append(x, concat(xs))

private fun all(p, ls) = if ls is
  Nil then true
  h :: t and
    p(h) then all(p, t)
    else false

private fun foldr(f, z, xs) = if xs is
  Nil then z
  h :: t then f(h, foldr(f, z, t))




object
  Bono
  Edge
  Larry
  Adam

private fun itemEq(a, b) = if a is
  Bono and b is Bono then true
  Edge and b is Edge then true
  Larry and b is Larry then true
  Adam and b is Adam then true
  else false

private fun succItem(i) = if i is
  Bono then Edge
  Edge then Larry
  Larry then Adam

private fun isEnd(i) = if i is
  Bono then false
  Edge then false
  Larry then false
  Adam then true

private fun itemFromTo(a, b) = if itemEq(a, b) then a :: Nil else a :: itemFromTo(succItem(a), b)


object
  LeftBank
  RightBank

private fun bankEq(a, b) = if a is
  LeftBank and b is LeftBank then true
  RightBank and b is RightBank then true
  else false

data class State(b, e, l, a)

private fun stateEq(s1, s2) = if s1 is State(a, b, c, d) and s2 is State(e, f, g, h) then
  (bankEq(a, e) && bankEq(b, f) && bankEq(c, g) && bankEq(d, h))

private fun bonoPos(s) = if s is State(a, b, c, d) then a

private fun edgePos(s) = if s is State(a, b, c, d) then b

private fun larryPos(s) = if s is State(a, b, c, d) then c

private fun adamPos(s) = if s is State(a, b, c, d) then d

val initialState = State(LeftBank, LeftBank, LeftBank, LeftBank)
//│ initialState = State(LeftBank, LeftBank, LeftBank, LeftBank)

val finalState = State(RightBank, RightBank, RightBank, RightBank)
//│ finalState = State(RightBank, RightBank, RightBank, RightBank)

private fun position(i, s) = if i is
  Bono then bonoPos(s)
  Edge then edgePos(s)
  Larry then larryPos(s)
  Adam then adamPos(s)

private fun updateState(s, i, pos) = if s is State(a, b, c, d) and i is
  Bono then State(pos, b, c, d)
  Edge then State(a, pos, c, d)
  Larry then State(a, b, pos, d)
  Adam then State(a, b, c, pos)

private fun opposite(b) = if b is
  LeftBank then RightBank
  RightBank then LeftBank

private fun notSeen(state, states) =
  all(case { [_, s] then not(stateEq(state, s)) }, states)

private fun writeItem(i, b, rest) = if i is
  Bono and b is LeftBank then nofibStringToList("    Bono |                    |\n") +: rest
  Edge and b is LeftBank then nofibStringToList("The Edge |                    |\n") +: rest
  Larry and b is LeftBank then nofibStringToList("   Larry |                    |\n") +: rest
  Adam and b is LeftBank then nofibStringToList("    Adam |                    |\n") +: rest
  Bono and b is RightBank then nofibStringToList("         |                    | Bono\n") +: rest
  Edge and b is RightBank then nofibStringToList("         |                    | The Edge\n") +: rest
  Larry and b is RightBank then nofibStringToList("         |                    | Larry\n") +: rest
  Adam and b is RightBank then nofibStringToList("         |                    | Adam\n") +: rest

private fun writeState(state, s) =
  nofibStringToList("----------------------------------------\n") +:
  writeItem of
    Bono
    bonoPos(state)
    writeItem of
      Edge
      edgePos(state)
      writeItem of
        Larry
        larryPos(state)
        writeItem of
          Adam
          adamPos(state)
          nofibStringToList("----------------------------------------\n") +: s

private fun totalTime(history) = if history is [time, _] :: _ then time

private fun writeHistory(history, x) = if history is
  Nil then x
  else
    foldr(
      (timestate, acc) => (s) => if timestate is [time, state] then
        nofibStringToList("Time: ") +: nofibStringToList(stringOfInt(totalTime(history) - time)) +: ("\n" :: writeState(state, acc(s))),
      x => x,
      history
    )(x)

private fun writeSolutions(solutions, count, s) = if solutions is
  Nil then s
  item :: next then
    nofibStringToList("Solution ") +:
    nofibStringToList(stringOfInt(count)) +:
    "\n" :: writeHistory(item, writeSolutions(next, count + 1, s))

private fun minSolutions(history) = if history is
  Nil then Nil
  history :: next then
    @tailrec
    fun minAcc(minSoFar, mins, ls) = if ls is
      Nil then mins
      history :: next then
        let total = totalTime(history)
        if
          minSoFar < total then minAcc(minSoFar, mins, next)
          minSoFar === total then minAcc(minSoFar, history :: mins, next)
          else minAcc(total, history :: Nil, next)
    reverse(minAcc(totalTime(history), history :: Nil, next))

private fun u2times(i) = if i is
  Bono then 10
  Edge then 5
  Larry then 2
  Adam then 1

private fun transfer(source, dest, location, countdown, history) =
  if stateEq(source, dest) then ([countdown, dest] :: history) :: Nil
  else
    let newHistory = [countdown, dest] :: history
    let newLocation = opposite(location)
    fun lscomp1(ls) = if ls is
      Nil then Nil
      item :: xs then
        if bankEq(position(item, dest), location) then
          let newDest = updateState(dest, item, newLocation)
          if notSeen(newDest, history) then
            let newTime = countdown + u2times(item)
            transfer(source, newDest, newLocation, newTime, newHistory) :: lscomp1(xs)
          else lscomp1(xs)
        else lscomp1(xs)
    let moveOne = concat(lscomp1(itemFromTo(Bono, Adam)))
    fun lscomp2(ls) = if ls is
      Nil then Nil
      i :: xs then
        fun lscomp3(ls) = if ls is
          Nil then lscomp2(xs)
          j :: ys then
            if bankEq(position(i, dest), location) and bankEq(position(j, dest), location) then
              let newDest = updateState(updateState(dest, i, newLocation), j, newLocation)
              if notSeen(newDest, history) then
                let newTime = countdown + u2times(i)
                transfer(source, newDest, newLocation, newTime, newHistory) :: lscomp3(ys)
              else lscomp3(ys)
            else lscomp3(ys)
        lscomp3(itemFromTo(succItem(i), Adam))
    let moveTwo = concat(lscomp2(itemFromTo(Bono, Larry)))
    moveOne +: moveTwo

private fun testPuzzle_nofib(x) =
  let time = if listLen(x) === 1 then 0
  let solutions = transfer(initialState, finalState, RightBank, time, Nil)
  let mins = minSolutions(solutions)
  writeSolutions(mins, 1, Nil)

fun main() = nofibListToString(testPuzzle_nofib(2 :: Nil))

