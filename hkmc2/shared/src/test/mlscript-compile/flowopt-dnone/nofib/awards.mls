#lang(0.3.x)

import "./NofibPrelude.mls"
import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
open NofibPrelude

// port changes from nofib/awards.mls: self-contained except for the shared NofibPrelude (the list functions it
// used are copied in); no type annotations; the varargs `list of ...` inputs are written as `::` chains


module awards with ...

// list functions copied from NofibPrelude

private fun ltList(xs, ys, lt, gt) = if xs is
  Nil and
    ys is Nil then false
    else true
  x :: xs and ys is
    Nil then false
    y :: ys and
      lt(x, y) then true
      gt(x, y) then false
      else ltList(xs, ys, lt, gt)

private fun ltTup2(t1, t2, lt1, gt1, lt2) = if t1 is [a, b] and t2 is [c, d] and
  lt1(a, c) then true
  gt1(a, c) then false
  else lt2(b, d)

private fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

private fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

private fun (+:) append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)

private fun filter(f, ls) = if ls is
  Nil then Nil
  h :: t and
    f(h) then h :: filter(f, t)
    else filter(f, t)

private fun foldl(f, a, xs) = if xs is
  Nil then a
  h :: t then foldl(f, f(a, h), t)

private fun deleteBy(eq, x, ys) = if ys is
  Nil then Nil
  y :: ys and
    eq(x, y) then ys
    else y :: deleteBy(eq, x, ys)

private fun sum(xs) =
  fun go(xs, a) = if xs is
    Nil then a
    h :: t then go(t, a + h)
  go(xs, 0)




private fun delete_(xs, e) = deleteBy((x, y) => x == y, e, xs)

private fun listDiff(a, ls) = foldl(delete_, a, ls)

//│ ————————————————————————————————————————————————————————————————————————————————
private fun qsort(le, ls, r) = if ls is
  Nil then r
  x :: Nil then x :: r
  x :: xs then qpart(le, x, xs, Nil, Nil, r)

private fun qpart(le, x, ys, rlt, rge, r) = if ys is
  Nil then rqsort(le, rlt, x :: rqsort(le, rge, r))
  y :: ys and
    le(x, y) then qpart(le, x, ys, rlt, y :: rge, r)
    else qpart(le, x, ys, y :: rlt, rge, r)

private fun rqsort(le, ls, r) = if ls is
  Nil then r
  x :: Nil then x :: r
  x :: xs then rqpart(le, x, xs, Nil, Nil, r)

private fun rqpart(le, x, yss, rle, rgt, r) = if yss is
  Nil then qsort(le, rle, x :: qsort(le, rgt, r))
  y :: ys and
    le(y, x) then rqpart(le, x, ys, y :: rle, rgt, r)
    else rqpart(le, x, ys, rle, y :: rgt, r)
//│ ————————————————————————————————————————————————————————————————————————————————

private fun sort(l) = qsort((a, b) => ltTup2(a, b, (a, b) => a < b, (a, b) => a > b, (a, b) => ltList(a, b, (a, b) => a < b, (a, b) => a > b)), l, Nil)

private fun perms(m, nns) = if
  nns is Nil then Nil
  m == 1 then map(x => x :: Nil, nns)
  nns is n :: ns then map(x => n :: x, perms(m-1, ns)) +: perms(m, ns)

private fun awards(scores) =
  let sumscores = map(p => [sum(p), p], perms(3, scores))

  fun atleast(threshold) =
    filter(case { [sum_, p] then sum_ >= threshold }, sumscores)

  fun award(name_threshold) = if name_threshold is [name, threshold] then
    map(ps => [name, ps], sort(atleast(threshold)))

  award(["Gold", 70]) +: award(["Silver", 60]) +: award(["Bronze", 50])

private fun findawards(scores) = if awards(scores) is
  Nil then Nil
  head_ :: tail_ and head_ is [award, [sum_, perm]] then
    [award, [sum_, perm]] :: findawards(listDiff(scores, perm))

private fun findallawards(competitors) =
  map(case { [name, scores] then [name, findawards(scores)] }, competitors)

private fun competitors(i) =
  ["Simon", 35 :: 27 :: 40 :: i :: 34 :: 21 :: Nil] ::
  ["Hans", 23 :: 19 :: 45 :: i :: 17 :: 10 :: 5 :: 8 :: 14 :: Nil] ::
  ["Phil", 1 :: 18 :: i :: 20 :: 21 :: 19 :: 34 :: 8 :: 16 :: 21 :: Nil] ::
  ["Kevin", 9 :: 23 :: 17 :: 54 :: i :: 41 :: 9 :: 18 :: 14 :: Nil] ::
  Nil

private fun testAwards_nofib(n) =
  map(x => findallawards(competitors(intMod(x, 100))), enumFromTo(1, n))


// NOTE: original input 1000
fun main() = testAwards_nofib(100)

