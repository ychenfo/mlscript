#lang(0.3.x)

import "./NofibPrelude.mls"
import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
open NofibPrelude

// port changes from nofib/lastpiece.mls: self-contained except for the shared NofibPrelude (the list functions
// it used are copied in); no type annotations; plain classes and objects instead of the class hierarchies; the
// `throw`s on impossible cases (`Tip` in rotations, `Above`/`Beside` after reduction, ...) are left out

module lastpiece with ...

// list functions copied from NofibPrelude

private fun fromSome(s) = if s is Some(x) then x

private fun snd(x) = if x is [f, s] then s

private fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

private fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

private fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

private fun (+:) append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)

private fun foldr(f, z, xs) = if xs is
  Nil then z
  h :: t then f(h, foldr(f, z, t))

private fun replicate(n, x) = if n == 0 then Nil else x :: replicate(n - 1, x)


// The port uses Haskell strings, represented by linked lists of characters.



private fun isSome(x) = x is Some

private fun mapMaybe(f, ls) = if ls is
  Nil then Nil
  h :: t and f(h) is
    None then mapMaybe(f, t)
    Some(a) then a :: mapMaybe(f, t)

object
  GT
  LT
  EQ

private fun compareIntInt(ab, cd) = if ab is [a, b] and cd is [c, d] and
  a > c then GT
  a < c then LT
  b > d then GT
  b < d then LT
  else EQ


object Tip

data class Bin(i, k, v, l, r)

private fun mapLookup(k, m) = if m is
  Tip then None
  Bin(_, kx, x, l, r) and compareIntInt(k, kx) is
    LT then mapLookup(k, l)
    GT then mapLookup(k, r)
    EQ then Some(x)

private fun size(p) = if p is
  Tip then 0
  Bin(sz, _, _, _, _) then sz

private fun bin(k, x, l, r) = Bin(size(l) + size(r) + 1, k, x, l, r)

private fun singleL(k1, x1, t1, r) = if r is
  Bin(_, k2, x2, t2, t3) then bin(k2, x2, bin(k1, x1, t1, t2), t3)

private fun singleR(k1, x1, l, t3) = if l is
  Bin(_, k2, x2, t1, t2) then bin(k2, x2, t1, bin(k1, x1, t2, t3))

private fun doubleL(k1, x1, t1, r) = if r is
  Bin(_, k2, x2, Bin(_, k3, x3, t2, t3), t4) then bin(k3, x3, bin(k1, x1, t1, t2), bin(k2, x2, t3, t4))

private fun doubleR(k1, x1, l, t4) = if l is
  Bin(_, k2, x2, t1, Bin(_, k3, x3, t2, t3)) then bin(k3, x3, bin(k2, x2, t1, t2), bin(k1, x1, t3, t4))

private fun rotateL(k, x, l, r) = if r is
  Bin(_, _, _, ly, ry) and
    size(ly) < 2 * size(ry) then singleL(k, x, l, r)
    else doubleL(k, x, l, r)

private fun rotateR(k, x, l, r) = if l is
  Bin(_, _, _, ly, ry) and
    size(ry) < 2 * size(ly) then singleR(k, x, l, r)
    else doubleR(k, x, l, r)

private fun balance(k, x, l, r) =
  let sizeL = size(l)
  let sizeR = size(r)
  let sizeX = sizeL + sizeR + 1
  if
    (sizeL + sizeR) <= 1 then Bin(sizeX, k, x, l, r)
    sizeR >= (4 * sizeL) then rotateL(k, x, l, r)
    sizeL >= (4 * sizeR) then rotateR(k, x, l, r)
    else Bin(sizeX, k, x, l, r)

private fun insert(kx, x, m) = if m is
  Tip then Bin(1, kx, x, Tip, Tip)
  Bin(sz, ky, y, l, r) and compareIntInt(kx, ky) is
    LT then balance(ky, y, insert(kx, x, l), r)
    GT then balance(ky, y, l, insert(kx, x, r))
    EQ then Bin(sz, kx, x, l, r)

private fun indent(n) = if n <= 0 then Nil else " " :: indent(n - 1)

data class P(i, a, b)


object
  Male
  Female

private fun flip(s) = if s is
  Male then Female
  Female then Male



data
  class
    Soln(b)
    Choose(s)
    Fail(b, s)

private fun addIntInt(row_col, orow_ocol) = if row_col is [row, col] and orow_ocol is [orow, ocol] then
  [row + orow, col + ocol]

private fun next(row_col) =  if row_col is [row, col] then [row, col + 1]

val maxRow = 8
//│ maxRow = 8

val maxCol = 8
//│ maxCol = 8

val emptyBoard = Tip
//│ emptyBoard = Tip

private fun check(bd, sq) = mapLookup(sq, bd)

private fun extend(bd, sq, id) = insert(sq, id, bd)

private fun extend_maybe(bd, sq, id) = if sq is [row, col] and
  (row > maxRow) || (col < 1) || (col > maxCol) then None
  check(bd, sq) is
    Some(_) then None
    None then Some(extend(bd, sq, id))

private fun pickOne(xs) =
  fun go(f, xs) = if xs is
    Nil then Nil
    x :: xs then [x, f(xs)] :: go(p => x :: f(p), xs)
  go(x => x, xs)

private fun fit(bd, sq, id, os) = if os is
  Nil then Some(extend(bd, sq, id))
  o :: os and extend_maybe(bd, addIntInt(sq, o), id) is
    Some(bd1) then fit(bd1, sq, id, os)
    None then None

//│ ————————————————————————————————————————————————————————————————————————————————
private fun tryy(sq, se, bd, id_is_ps) = if id_is_ps is [id, os, ps] and fit(bd, sq, id, os) is
  Some(bd1) then Some(search(next(sq), flip(se), bd1, ps))
  None then None

private fun search(row_col, sey, bd, ps) = if row_col is [row, col] and
  ps is Nil then Soln(bd)
  col === (maxCol + 1) then search([row + 1, 1], flip(sey), bd, ps)
  check(bd, row_col) is Some(_) then search(next(row_col), flip(sey), bd, ps)
  else
    fun lscomp1(ls) = if ls is
      Nil then Nil
      [P(id, ms, fs), ps] :: ls then
        fun lscomp2(ls2) = if ls2 is
          Nil then lscomp1(ls)
          os :: ls then [id, os, ps] :: lscomp2(ls)
        lscomp2(if sey is Male then ms else fs)
    let choices = lscomp1(pickOne(ps))
    if mapMaybe(x => tryy(row_col, sey, bd, x), choices) is
      Nil then Fail(bd, row_col)
      ss then Choose(ss)
//│ ————————————————————————————————————————————————————————————————————————————————

