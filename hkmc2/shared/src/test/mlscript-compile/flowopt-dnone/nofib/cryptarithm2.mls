#lang(0.3.x)

import "./NofibPrelude.mls"
import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
open NofibPrelude

// port changes from nofib/cryptarithm2.mls: self-contained except for the shared NofibPrelude (the list
// functions it used are copied in); no type annotations; the two `throw` guards in the result check are negated
// into the guard of the result (same result when they do not fire)

module cryptarithm2 with ...

// list functions copied from NofibPrelude

private fun fromSome(s) = if s is Some(x) then x

private fun reverse(l) =
  fun r(l', l) = if l is x :: xs then r(x :: l', xs) else l'
  r(Nil, l)

private fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

private fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

private fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

private fun (+:) append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)

private fun concat(ls) = if ls is
  Nil then Nil
  x :: xs then append(x, concat(xs))

private fun filter(f, ls) = if ls is
  Nil then Nil
  h :: t and
    f(h) then h :: filter(f, t)
    else filter(f, t)

private fun foldl(f, a, xs) = if xs is
  Nil then a
  h :: t then foldl(f, f(a, h), t)

private fun foldr(f, z, xs) = if xs is
  Nil then z
  h :: t then f(h, foldr(f, z, t))

private fun nubBy(eq, ls) = if ls is
  Nil then Nil
  h :: t then h :: nubBy(eq, filter(y => not(eq(h, y)), t))

private fun deleteBy(eq, x, ys) = if ys is
  Nil then Nil
  y :: ys and
    eq(x, y) then ys
    else y :: deleteBy(eq, x, ys)

private fun sum(xs) =
  fun go(xs, a) = if xs is
    Nil then a
    h :: t then go(t, a + h)
  go(xs, 0)

private fun unzip(l) =
  fun f(l, a, b) = if l is
    Nil then [reverse(a), reverse(b)]
    [x, y] :: t then f(t, x :: a,  y :: b)
  f(l, Nil, Nil)

private fun transpose(xss) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    h :: t and h is
      hd :: tl then [hd, tl] :: lscomp(t)
      else lscomp(t)
  fun combine(y, h, ys, t) = (y :: h) :: transpose(ys :: t)
  if xss is
    Nil then Nil
    Nil :: xss then transpose(xss)
    (x :: xs) :: xss and unzip(lscomp(xss)) is [hds, tls] then combine(x, hds, xs, tls)



object Unit

private fun unlines(ls) = concat of map(x => x +: ("\n" :: Nil), ls)

private fun lookup(k, t) = if t is
  Nil then None
  [x, v] :: t then if k === x then Some(v) else lookup(k, t)

private fun delete_(xs, e) = deleteBy((x, y) => x === y, e, xs)

private fun listDiff(a, ls) = foldl(delete_, a, ls)

data class StateT(run)

private fun runStateT(m, s) = if m is StateT(run) then run(s)

private fun bind(m, f) =
  StateT of
    s => concat of map(case { [a, ss] then runStateT(f(a), ss) }, runStateT(m, s))

private fun return_(a) = StateT(s => [a, s] :: Nil)

private fun mapM(f, ls) = foldr((a, r) => bind(f(a), x => bind(r, xs => return_(x :: xs))), return_(Nil), ls)

private fun lift(ls) = StateT(s => concat(map(x => [x, s] :: Nil, ls)))

private fun execStateT(m, s) = concat(map(case { [a, s] then s :: Nil }, runStateT(m, s)))

private fun guard(b) = if b then StateT(s => [Unit, s] :: Nil) else StateT(s => Nil)

private fun put(s) = StateT(x => [Unit, s] :: Nil)

val get = StateT(s => [s, s] :: Nil)
//│ get = StateT([function])

data class Digits(i, c)

private fun digits(d) = if d is Digits(a, b) then a

private fun digitEnv(d) = if d is Digits(a, b) then b

private fun permute(c) =
  bind of
    get
    st =>
      bind of
        let xs = digits(st) in lift(map(x => [x, listDiff(xs, x :: Nil)], xs))
        iis =>
          if iis is [i, iss] then
            bind of
              put(Digits(iss, [c, i] :: digitEnv(st)))
              _p => return_(i)

private fun select(c) =
  bind of
    get
    st =>
      if lookup(c, digitEnv(st)) is
        Some(r) then return_(r)
        None then permute(c)

private fun rest(ls) = if ls is
  Nil then Nil
  x :: xs then xs

private fun solve(tops, bots, carry) = if bots is
  bot :: botss then
    bind of
      if tops is
        Nil then return_(carry)
        top :: _ then bind(mapM(select, top), topNS => return_(sum(topNS) + carry))
      topN => bind of
        select(bot)
        botN => bind of
          guard(intMod(topN, 10) === botN)
          _s => solve(rest(tops), botss, intDiv(topN, 10))
  Nil and tops is Nil and carry === 0 then return_(Unit)
  else StateT(_p => Nil)

private fun puzzle(top, bot) =
  let solution = solve(transpose(map(reverse, top)), reverse(bot), 0)
  let answer = if execStateT(solution, Digits(enumFromTo(0, 9), Nil)) is a :: _ then a
  let env = digitEnv(answer)
  let look = c => fromSome(lookup(c, env))
  let expand = ls => foldl((a, b) => a * 10 + look(b), 0, ls)
  let topVal = sum(map(xs => expand(xs), top))
  let botVal = expand(bot)
  if
    listLen(nubBy((x,y) => x === y, concat(top) +: bot)) <= 10 and topVal == botVal then unlines of map of
      case { [c, i] then c :: nofibStringToList(" => ") +: nofibStringToList(stringOfInt(i)) }
      env

private fun testCryptarithm2_nofib(n) =
  let args =
    nofibStringToList("THIRTY") ::
    nofibStringToList("TWELVE") ::
    nofibStringToList("TWELVE") ::
    nofibStringToList("TWELVE") ::
    nofibStringToList("TWELVE") ::
    append(nofibStringToList("TWELVE"), (if n > 999999 then nofibStringToList("1") else Nil)) :: Nil
  puzzle(args, nofibStringToList("NINETY"))

fun main() = testCryptarithm2_nofib(1).toString()
