#lang(0.3.x)

import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"

open annotations { pure }


module mcray with ...


data class (::) Cons(head, tail)
object Nil

data class Some(value)
object None

class Ref(val value)

private fun listFoldl(f)(init)(l) = if l is
  Nil then init
  x :: xs then listFoldl(f)(f(x, init))(xs)


private fun listTabulate(n, f) =
  fun go(i) = if i >= n then Nil else f(i) :: go(i + 1)
  go(0)


private fun posInf() = 1.0 / 0.0

private fun pi() = 3.14159265358979323846

@pure private fun sqrt(x) = globalThis.Math.sqrt(x)

@pure private fun tan(x) = globalThis.Math.tan(x)


@pure private fun floor(x) = globalThis.Math.floor(x)

private fun real(x) = x

private fun intMod(a, b) = a - b * floor(a / b)




private fun gen32(rng) =
  let x = rng.Ref#value
  let x1 = intMod(x * 48271, 2147483647)
  set rng.Ref#value = x1
  x1

private fun rand(rng) =
  let scale = 1.0 / 2147483647.0
  scale * real(gen32(rng))


private fun within(t, minMax) = if minMax is [min, max] then min <= t && t <= max


private fun rgbAdd(c1, c2) = if c1 is [r1, g1, b1] and c2 is [r2, g2, b2] then [r1 + r2, g1 + g2, b1 + b2]


private fun rgbModulate(c1, c2) = if c1 is [r1, g1, b1] and c2 is [r2, g2, b2] then [r1 * r2, g1 * g2, b1 * b2]

private fun rgbScale(s, c) = if c is [r, g, b] then [s * r, s * g, s * b]

private fun rgbLerp(c1, t, c2) = rgbAdd(rgbScale(1.0 - t, c1), rgbScale(t, c2))

private fun rgbBlack() = [0.0, 0.0, 0.0]
private fun rgbWhite() = [1.0, 1.0, 1.0]
private fun rgbGray(v) = [v, v, v]


private fun toByte(f) =
  let f1 = floor(f * 255.99)
  if
    f1 <= 0 then 0
    255 <= f1 then 255
    else f1


private fun colorFromRGBWithGamma(c) = if c is [r, g, b] then
  fun cvt(f) = toByte(sqrt(f))
  [cvt(r), cvt(g), cvt(b)]



private fun epsilon() = 0.0001

private fun vec3Zero() = [0.0, 0.0, 0.0]


private fun vec3Add(v1, v2) = if v1 is [x1, y1, z1] and v2 is [x2, y2, z2] then [x1 + x2, y1 + y2, z1 + z2]

private fun vec3Sub(v1, v2) = if v1 is [x1, y1, z1] and v2 is [x2, y2, z2] then [x1 - x2, y1 - y2, z1 - z2]


private fun vec3Scale(s, v) = if v is [x, y, z] then [s * x, s * y, s * z]

private fun vec3Adds(v1, s, v2) = vec3Add(v1, vec3Scale(s, v2))

private fun vec3Dot(v1, v2) = if v1 is [x1, y1, z1] and v2 is [x2, y2, z2] then x1 * x2 + y1 * y2 + z1 * z2


private fun vec3Cross(v1, v2) = if v1 is [x1, y1, z1] and v2 is [x2, y2, z2] then
  [y1 * z2 - z1 * y2, z1 * x2 - x1 * z2, x1 * y2 - y1 * x2]

private fun vec3LengthSq(v) = vec3Dot(v, v)
private fun vec3Length(v) = sqrt(vec3LengthSq(v))


private fun vec3LengthAndDir(v) =
  let l = vec3Length(v)
  if l < epsilon() then [0.0, vec3Zero()] else [l, vec3Scale(1.0 / l, v)]

private fun vec3Normalize(v) = if vec3LengthAndDir(v) is [_, d] then d

private fun vec3Reflect(v, n) = vec3Adds(v, -2.0 * vec3Dot(v, n), n)


private fun vec3RandomPointInSphere(rng) =
  let pt = [rand(rng), rand(rng), rand(rng)]
  if vec3Dot(pt, pt) < 1.0 then pt else vec3RandomPointInSphere(rng)


private fun rayMake(origin, dir) = [origin, vec3Normalize(dir)]

private fun rayEval(ray, t) = if ray is [origin, dir] then vec3Adds(origin, t, dir)


data class MatHit(t, pt, norm, material)
data class Material(emit, scatter)

private fun getEmission(hit) = if hit is MatHit(_, _, _, Material(emit, _)) then emit(hit)

private fun getHitInfo(hit, ray) = if hit is MatHit(_, _, _, Material(_, scatter)) then scatter(ray, hit)


private fun lambertian(rng, albedo) = Material(
  hit => rgbBlack(),
  (ray, hit) => if hit is MatHit(_, pt, norm, _) then Some([
    albedo,
    rayMake(pt, vec3Add(norm, vec3RandomPointInSphere(rng)))]))

private fun metal(rng, albedo, fuzz) = Material(
  hit => rgbBlack(),
  (ray, hit) => if ray is [_, rdir] and hit is MatHit(_, pt, norm, _) then
    let dir = vec3Adds(vec3Reflect(rdir, norm), fuzz, vec3RandomPointInSphere(rng))
    if vec3Dot(dir, norm) <= 0.0 then None else Some([albedo, rayMake(pt, dir)]))


object Miss
data class ObjHit(hit)

data class Obj(hit)

private fun hitTest(obj, ray, minMaxT) = if obj is Obj(hit) then hit(ray, minMaxT)

private fun objectEmpty() = Obj((ray, minMaxT) => Miss)


private fun closer(maybeHit1, maybeHit2) = if
  maybeHit1 is Miss then maybeHit2
  maybeHit2 is Miss then maybeHit1
  maybeHit1 is ObjHit(MatHit(t1, _, _, _)) and maybeHit2 is ObjHit(MatHit(t2, _, _, _)) then
    if t1 <= t2 then maybeHit1 else maybeHit2

private fun fromList(objs) = if objs is
  Nil then objectEmpty()
  obj :: Nil then obj
  else
    fun hitTest1(ray, minMaxT) =
      listFoldl((obj, mhit) => closer(mhit, hitTest(obj, ray, minMaxT)))(Miss)(objs)
    Obj(hitTest1)


private fun sphereMake(center, radius, material) =
  let rSq = radius * radius
  let invR = 1.0 / radius
  fun hitTest1(ray, minMaxT) = if ray is [ro, rd] then
    let q = vec3Sub(ro, center)
    let b = 2.0 * vec3Dot(rd, q)
    let c = vec3Dot(q, q) - rSq
    let disc = b * b - 4.0 * c
    if disc < 0.0 then Miss
    else
      let t = 0.5 * (-b - sqrt(disc))
      if within(t, minMaxT) then
        let pt = rayEval(ray, t)
        ObjHit(MatHit(t, pt, vec3Scale(invR, vec3Sub(pt, center)), material))
      else Miss
  Obj(hitTest1)


data class Img(wid, ht, pixels)


data class Cam(wid, ht, ns, pos, ulc, hvec, vvec)

private fun cameraMake(wid, ht, ns, pos, lookAt, up, fov) =
  let dir = vec3Normalize(vec3Sub(lookAt, pos))
  let right = vec3Normalize(vec3Cross(dir, up))
  let up1 = vec3Normalize(vec3Cross(right, dir))
  let pw = 2.0 / real(wid)
  let aspect = real(ht) / real(wid)
  let theta = (pi() * fov) / 180.0
  let flen = 1.0 / tan(0.5 * theta)
  let imgCenter = vec3Add(pos, vec3Scale(flen, dir))
  let ulc = vec3Sub(vec3Add(imgCenter, vec3Scale(aspect, up1)), right)
  Cam(wid, ht, ns, pos, ulc, vec3Scale(pw, right), vec3Scale(-pw, up1))


private fun makePixelRenderer(toRGB, cvt)(r, c) = cvt(toRGB(r, c))

private fun foreachPixel(cam, pr) = if cam is Cam(wid, ht, _, _, _, _, _) then
  fun rowLp(r, colors) = if r < 0 then colors else colLp(r - 1, wid - 1, colors)
  fun colLp(r, c, colors) = if c < 0 then rowLp(r, colors) else colLp(r, c - 1, pr(r, c) :: colors)
  Img(wid, ht, rowLp(ht - 1, Nil))


private fun rayToRGB(ray) = if ray is [_, [_, y, _]] then
  rgbLerp(rgbWhite(), 0.5 * (y + 1.0), [0.5, 0.7, 1.0])

private fun raysForPixel(rng, cam)(r, c) = if cam is Cam(_, _, ns, pos, ulc, hvec, vvec) then
  let r1 = real(r)
  let c1 = real(c)
  let ulcDir = vec3Sub(ulc, pos)
  fun mkRay(i) =
    let dir = vec3Adds(ulcDir, r1 + rand(rng), vvec)
    let dir1 = vec3Adds(dir, c1 + rand(rng), hvec)
    rayMake(pos, dir1)
  listTabulate(ns, mkRay)

private fun aaPixelToRGB(rng, cam, trace) = if cam is Cam(_, _, ns, _, _, _, _) then
  let rfp = raysForPixel(rng, cam)
  let scale = if ns == 0 then 1.0 else 1.0 / real(ns)
  (r, c) => rgbScale(scale, listFoldl((ray, c1) => rgbAdd(c1, trace(ray)))(rgbBlack())(rfp(r, c)))


private fun traceRay(world, maxDepth) =
  let minMaxT = [0.001, posInf()]
  fun trace(ray, depth) =
    if depth <= 0 then rgbBlack()
    else
      if hitTest(world, ray, minMaxT) is
        Miss then rayToRGB(ray)
        ObjHit(hit) then if getHitInfo(hit, ray) is
          None then getEmission(hit)
          Some([aten, reflect]) then rgbAdd(getEmission(hit), rgbModulate(aten, trace(reflect, depth - 1)))
  ray => trace(ray, maxDepth)

private fun rayTracer(rng, cam, world) =
  foreachPixel(cam, makePixelRenderer(aaPixelToRGB(rng, cam, traceRay(world, 20)), colorFromRGBWithGamma))


private fun randomSphere(rng, x, z) =
  let chooseMat = rand(rng)
  let x1 = real(x) + (0.9 * rand(rng))
  let z1 = real(z) + (0.9 * rand(rng))
  let c = [x1, 0.2, z1]
  let mat =
    if chooseMat < 0.8 then lambertian(rng, [rand(rng) * rand(rng), rand(rng) * rand(rng), rand(rng) * rand(rng)])
    else metal(rng, [0.5 * (1.0 + rand(rng)), 0.5 * (1.0 + rand(rng)), 0.5 * (1.0 + rand(rng))], 0.5 * rand(rng))
  sphereMake(c, 0.2, mat)

private fun makeScene(rng) =
  fun lp(x, z, objs) =
    if z < 11 then lp(x, z + 1, randomSphere(rng, x, z) :: objs)
    else if x < 11 then lp(x + 1, -11, objs)
    else objs
  fromList(lp(-11, -11,
    sphereMake([0.0, -1000.0, 0.0], 1000.0, lambertian(rng, rgbGray(0.5))) ::
    sphereMake([4.0, 1.0, 0.0], 1.0, metal(rng, [0.7, 0.6, 0.5], 0.0)) ::
    sphereMake([-4.0, 1.0, 0.0], 1.0, lambertian(rng, [0.4, 0.2, 0.1])) ::
    Nil))

private fun buildScene(rng, wid, ht, ns) =
  let cam = cameraMake(wid, ht, ns, [13.0, 2.0, 3.0], vec3Zero(), [0.0, 1.0, 0.0], 30.0)
  let world = makeScene(rng)
  [cam, world]

fun main() =
  let rng = new mut Ref(1234567)
  if buildScene(rng, 3, 2, 5) is [cam, world] then rayTracer(rng, cam, world)
