#lang(0.3.x)

import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"

open annotations { pure }


module fft with ...



data class (::) Cons(head, tail)
object Nil

@pure private fun cos(x) = globalThis.Math.cos(x)

@pure private fun sin(x) = globalThis.Math.sin(x)

@pure private fun abs(x) = globalThis.Math.abs(x)

@pure private fun floor(x) = globalThis.Math.floor(x)

private fun intDiv(a, b) = floor(a / b)

private fun fromInt(i) = i

private fun pi() = 3.141592653589793

private fun fillArray(arr, i, n, x) = if i == n then arr else
  set arr.[i] = x
  fillArray(arr, i + 1, n, x)

private fun aArray(n, x) = fillArray(mut [], 0, n, x)

private fun aSub(a, i) = a.[i]

private fun aUpdate(a, i, x) = set a.[i] = x


private fun tpi() = 2.0 * pi()

private fun fft(px)(py)(np) =
  fun find_num_points(i)(m) = if i < np then find_num_points(i + i)(m + 1) else [i, m]
  if find_num_points(2)(1) is [n, m] then
    if n != np then
      fun loop(i) =
        if i > n then ()
        else
          aUpdate(px, i, 0.0)
          aUpdate(py, i, 0.0)
          loop(i + 1)
      loop(np + 1)
    else ()
    fun loop_k(k)(n2) =
      if k >= m then ()
      else
        let n4 = intDiv(n2, 4)
        let e = tpi() / fromInt(n2)
        fun loop_j(j)(a) =
          if j > n4 then ()
          else
            let a3 = 3.0 * a
            let cc1 = cos(a)
            let ss1 = sin(a)
            let cc3 = cos(a3)
            let ss3 = sin(a3)
            fun loop_is(is_)(id) =
              if is_ >= n then ()
              else
                fun loop_i0(i0) =
                  if i0 >= n then ()
                  else
                    let i1 = i0 + n4
                    let i2 = i1 + n4
                    let i3 = i2 + n4
                    let r1 = aSub(px, i0) - aSub(px, i2)
                    aUpdate(px, i0, aSub(px, i0) + aSub(px, i2))
                    let r2 = aSub(px, i1) - aSub(px, i3)
                    aUpdate(px, i1, aSub(px, i1) + aSub(px, i3))
                    let s1 = aSub(py, i0) - aSub(py, i2)
                    aUpdate(py, i0, aSub(py, i0) + aSub(py, i2))
                    let s2 = aSub(py, i1) - aSub(py, i3)
                    aUpdate(py, i1, aSub(py, i1) + aSub(py, i3))
                    let s3 = r1 - s2
                    let r1b = r1 + s2
                    let s2b = r2 - s1
                    let r2b = r2 + s1
                    aUpdate(px, i2, r1b * cc1 - s2b * ss1)
                    aUpdate(py, i2, (-s2b) * cc1 - r1b * ss1)
                    aUpdate(px, i3, s3 * cc3 + r2b * ss3)
                    aUpdate(py, i3, r2b * cc3 - s3 * ss3)
                    loop_i0(i0 + id)
                loop_i0(is_)
                loop_is(2 * id - n2 + j)(4 * id)
            loop_is(j)(2 * n2)
            loop_j(j + 1)(e * fromInt(j))
        loop_j(1)(0.0)
        loop_k(k + 1)(intDiv(n2, 2))
    loop_k(1)(n)
    fun loop_is2(is_)(id) =
      if is_ >= n then ()
      else
        fun loop_i02(i0) =
          if i0 > n then ()
          else
            let i1 = i0 + 1
            let r1 = aSub(px, i0)
            aUpdate(px, i0, r1 + aSub(px, i1))
            aUpdate(px, i1, r1 - aSub(px, i1))
            let r1b = aSub(py, i0)
            aUpdate(py, i0, r1b + aSub(py, i1))
            aUpdate(py, i1, r1b - aSub(py, i1))
            loop_i02(i0 + id)
        loop_i02(is_)
        loop_is2(2 * id - 1)(4 * id)
    loop_is2(1)(4)
    fun loop_i(i)(j) =
      if i >= n then ()
      else
        if i < j then
          let xt = aSub(px, j)
          aUpdate(px, j, aSub(px, i))
          aUpdate(px, i, xt)
          let xt1 = aSub(py, j)
          aUpdate(py, j, aSub(py, i))
          aUpdate(py, i, xt1)
        else ()
        fun loop_k(k)(j) = if k < j then loop_k(intDiv(k, 2))(j - k) else j + k
        let j1 = loop_k(intDiv(n, 2))(j)
        loop_i(i + 1)(j1)
    loop_i(1)(1)
    n

private fun test(np) =
  let enp = fromInt(np)
  let npm = intDiv(np, 2) - 1
  let pxr = aArray(np + 2, 0.0)
  let pxi = aArray(np + 2, 0.0)
  let t = pi() / enp
  aUpdate(pxr, 1, (enp - 1.0) * 0.5)
  aUpdate(pxi, 1, 0.0)
  let n2 = intDiv(np, 2)
  aUpdate(pxr, n2 + 1, -0.5)
  aUpdate(pxi, n2 + 1, 0.0)
  fun loop_i(i) =
    if i > npm then ()
    else
      let j = np - i
      aUpdate(pxr, i + 1, -0.5)
      aUpdate(pxr, j + 1, -0.5)
      let z = t * fromInt(i)
      let y = -0.5 * (cos(z) / sin(z))
      aUpdate(pxi, i + 1, y)
      aUpdate(pxi, j + 1, -y)
      loop_i(i + 1)
  loop_i(1)
  fft(pxr)(pxi)(np)
  fun loop_i2(i)(zr)(zi)(kr)(ki) =
    if i >= np then [zr, zi]
    else
      let a = abs(aSub(pxr, i + 1) - fromInt(i))
      let p1 = if zr < a then [a, i] else [zr, kr]
      if p1 is [zr1, kr1] then
        let a1 = abs(aSub(pxi, i + 1))
        let p2 = if zi < a1 then [a1, i] else [zi, ki]
        if p2 is [zi1, ki1] then loop_i2(i + 1)(zr1)(zi1)(kr1)(ki1)
  if loop_i2(0)(0.0)(0.0)(0)(0) is [zr, zi] then
    let zm = if abs(zr) < abs(zi) then zi else zr
    zm

private fun nSizes() = 14

private fun loop_np(i)(np) = if i > nSizes() then Nil else test(np) :: loop_np(i + 1)(np * 2)

fun main() = loop_np(1)(16)
