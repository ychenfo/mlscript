            unify(t_2, STR(cons_s, l1 :: STR(cons_s, STR(cons_s, p1 :: STR(cons_s, con_x_s :: STR(cons_s, con_o_s :: STR(cons_s, con_o_s :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: tt :: Nil) :: Nil))(() =>
