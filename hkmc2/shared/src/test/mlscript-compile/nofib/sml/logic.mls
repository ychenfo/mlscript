                        sc()))))))
            exists_(t =>
              exists_(tt =>
                unify(t_1, STR(cons_s, STR(cons_s, con_o_s :: STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: t :: Nil) :: Nil) :: Nil) :: tt :: Nil))(() =>
                  unify(t_2, STR(cons_s, STR(cons_s, con_x_s :: STR(cons_s, con_o_s :: STR(cons_s, con_o_s :: t :: Nil) :: Nil) :: Nil) :: tt :: Nil))(() =>
