                              unify(t_2, STR(cons_s, STR(cons_s, con_o_s :: STR(cons_s, con_o_s :: STR(cons_s, con_x_s :: t :: Nil) :: Nil) :: Nil) :: tt :: Nil))(() =>
                                sc())))))
                      exists_(p1 =>
