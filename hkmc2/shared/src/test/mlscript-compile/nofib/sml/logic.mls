#lang(0.3.x)

import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"


module logic with ...



data class (::) Cons(head, tail)
object Nil

data class Some(value)
object None

class Ref(val value)



data class STR(f, ts)
data class INT(n)
data class CON(s)
data class REF(r)



private val global_trail = new mut Ref(Nil)
private val trail_counter = new mut Ref(0)

private fun unwind_trail(n, tr) = if
  n == 0 then tr
  tr is r :: tr1 then
    set r.Ref#value = None
    unwind_trail(n - 1, tr1)

private fun reset_trail() = set global_trail.Ref#value = Nil

private fun trail(func) =
  let tc0 = trail_counter.Ref#value
  func()
  set global_trail.Ref#value = unwind_trail(trail_counter.Ref#value - tc0, global_trail.Ref#value)
  set trail_counter.Ref#value = tc0

private fun bind(r, t) =
  set r.Ref#value = Some(t)
  set global_trail.Ref#value = r :: global_trail.Ref#value
  set trail_counter.Ref#value = trail_counter.Ref#value + 1



private val found = new mut Ref(false)

private fun same_ref(r, t) = if t is REF(r1) then r === r1 else false

private fun occurs_check(r)(t) =
  fun oc(t) = if t is
    STR(_, ts) then ocs(ts)
    REF(r1) then (if r1.Ref#value is
      Some(s) then oc(s)
      else r !== r1)
    CON(_) then true
    INT(_) then true
  fun ocs(ts) = if ts is
    Nil then true
    t :: ts1 then oc(t) && ocs(ts1)
  oc(t)

private fun deref(t) = if
  t is REF(x) and x.Ref#value is Some(s) then deref(s)
  else t

private fun unify1(p1, p2)(sc) = if
  p1 is REF(r) then unify_REF(r, p2)(sc)
  p2 is REF(r) then unify_REF(r, p1)(sc)
  p1 is STR(f, ts) and p2 is STR(g, ss) then if f == g then unifys(ts, ss)(sc) else ()
  p1 is CON(f) and p2 is CON(g) then if f == g then sc() else ()
  p1 is INT(f) and p2 is INT(g) then if f == g then sc() else ()
  else ()

private fun unifys(l1, l2)(sc) = if
  l1 is Nil and l2 is Nil then sc()
  l1 is t :: ts and l2 is s :: ss then unify1(deref(t), deref(s))(() => unifys(ts, ss)(sc))
  else ()

private fun unify_REF(r, t)(sc) =
  if same_ref(r, t) then sc()
  else if occurs_check(r)(t) then
    bind(r, t)
    sc()
  else ()

private fun unify(s, t)(sc) = if found.Ref#value then () else unify1(deref(s), deref(t))(sc)



private val cons_s = "cons"
private val x_s = "x"
private val nil_s = "nil"
private val o_s = "o"
private val s_s = "s"
private val con_o_s = CON(o_s)
private val con_nil_s = CON(nil_s)
private val con_x_s = CON(x_s)

private fun exists_(sc) = sc(REF(new mut Ref(None)))

