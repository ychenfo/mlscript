private fun rotate(unify, exists_, trail)(t_1, t_2)(sc) =
  exists_(p11 =>
    exists_(p12 =>
      exists_(p13 =>
        exists_(p14 =>
          exists_(p15 =>
            exists_(p21 =>
              exists_(p22 =>
                exists_(p23 =>
                  exists_(p24 =>
                    exists_(p31 =>
                      exists_(p32 =>
                        exists_(p33 =>
                          exists_(p41 =>
                            exists_(p42 =>
                              exists_(p51 =>
                                unify(t_1, STR(cons_s, STR(cons_s, p11 :: STR(cons_s, p12 :: STR(cons_s, p13 :: STR(cons_s, p14 :: STR(cons_s, p15 :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p21 :: STR(cons_s, p22 :: STR(cons_s, p23 :: STR(cons_s, p24 :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p31 :: STR(cons_s, p32 :: STR(cons_s, p33 :: con_nil_s :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p41 :: STR(cons_s, p42 :: con_nil_s :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p51 :: con_nil_s :: Nil) :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: Nil))(() =>
                                  unify(t_2, STR(cons_s, STR(cons_s, p51 :: STR(cons_s, p41 :: STR(cons_s, p31 :: STR(cons_s, p21 :: STR(cons_s, p11 :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p42 :: STR(cons_s, p32 :: STR(cons_s, p22 :: STR(cons_s, p12 :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p33 :: STR(cons_s, p23 :: STR(cons_s, p13 :: con_nil_s :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p24 :: STR(cons_s, p14 :: con_nil_s :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, p15 :: con_nil_s :: Nil) :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: Nil))(() =>
                                    sc())))))))))))))))))

private fun move(unify, exists_, trail)(t_1, t_2)(sc) =
  trail(() =>
    trail(() =>
      exists_(x =>
        exists_(y =>
          unify(t_1, x)(() =>
            unify(t_2, y)(() =>
              move_horiz(unify, exists_, trail)(x, y)(sc))))))
    exists_(x =>
      exists_(x1 =>
        exists_(y =>
          exists_(y1 =>
            unify(t_1, x)(() =>
              unify(t_2, y)(() =>
                rotate(unify, exists_, trail)(x, x1)(() =>
                  move_horiz(unify, exists_, trail)(x1, y1)(() =>
                    rotate(unify, exists_, trail)(y, y1)(sc))))))))))
  exists_(x =>
    exists_(x1 =>
      exists_(y =>
        exists_(y1 =>
          unify(t_1, x)(() =>
            unify(t_2, y)(() =>
              rotate(unify, exists_, trail)(x1, x)(() =>
                move_horiz(unify, exists_, trail)(x1, y1)(() =>
                  rotate(unify, exists_, trail)(y1, y)(sc)))))))))

private fun solitaire(unify, exists_, trail)(t_1, t_2, t_3)(sc) =
  trail(() =>
    exists_(x =>
      unify(t_1, x)(() =>
        unify(t_2, STR(cons_s, x :: con_nil_s :: Nil))(() =>
          unify(t_3, INT(0))(() =>
            sc())))))
  exists_(n =>
    exists_(x =>
      exists_(y =>
        exists_(z =>
          unify(t_1, x)(() =>
            unify(t_2, STR(cons_s, x :: z :: Nil))(() =>
              unify(t_3, STR(s_s, n :: Nil))(() =>
                move(unify, exists_, trail)(x, y)(() =>
                  solitaire(unify, exists_, trail)(y, z, n)(sc)))))))))

private fun solution2(unify, exists_, trail)(t_1)(sc) =
  exists_(x =>
    unify(t_1, x)(() =>
      solitaire(unify, exists_, trail)(STR(cons_s, STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, con_x_s :: STR(cons_s, con_o_s :: STR(cons_s, con_x_s :: con_nil_s :: Nil) :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, con_x_s :: STR(cons_s, con_x_s :: con_nil_s :: Nil) :: Nil) :: STR(cons_s, STR(cons_s, con_x_s :: con_nil_s :: Nil) :: con_nil_s :: Nil) :: Nil) :: Nil) :: Nil) :: Nil), x, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, STR(s_s, INT(0) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil) :: Nil))(sc)))



fun main() =
  set found.Ref#value = false
  reset_trail()
  set trail_counter.Ref#value = 0
  exists_(z => solution2(unify, exists_, trail)(z)(() => set found.Ref#value = true))
  found.Ref#value
