#lang(0.3.x)

import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"

open annotations { pure }

// ratio regions (cox, rao and zhong) image segmentation, reduced to max flow and solved by
// preflow-push with periodic relabeling and a wave-based heuristic (sebastien roy)
// source: stephen weeks's sml translation of jeffrey mark siskind's scheme code (mlton benchmarks),
// as adapted for 3cps in the webs artifact (zenodo 15050194), 3cps/test/programs/examples/ratio-regions.sml
// port changes:
// - the 3cps "basis library" prelude is flattened: the scheme-style aliases keep their names and take the
//   bodies of the prelude functions they alias (make_vector = Array.array, map_n_vector = Array.tabulate,
//   modulo = Int.mod, quotient = Int.quot, string_ref = String.sub, …); the 3cps primitive array_alloc
//   fills a `mut` tuple, array_length/sub/update are `.length`/`![i]`/`set ![i]` (unchecked indexing:
//   the resolver merges the shapes of all arrays reaching vector_ref, ints included, and rejects `.[i]`)
// - renamed to avoid clashes: the queue's Nil/Cons are QNil/QCons (lists keep Nil/Cons), pormatValue's
//   Int/String are PInt/PString, the accessors x/y are px/py, null/not/print are isNull/not_/print_;
//   the inner `loop`s of preflow_push's wave loop and of the lg_v loop are loopK and loopPow, since an
//   mlscript block would capture the outer `loop` called after them
// - printing stays silenced (print_, write_char and intToString do nothing), but pormat still walks its
//   control strings as in the original
// - the impossible `raise Size` (n <= 0), `raise Fail "min"` and `raise Fail "dequeue"` cases are left out
// - unused definitions are dropped (some_n)
// - `main` returns `doit 5`, the min cut as a `bool` array of arrays

module ratioRegions with ...



data class (::) Cons(head, tail)
object Nil

class Ref(val value)

@pure private fun floor(x) = globalThis.Math.floor(x)

private fun listApp(f)(l) = if l is
  Nil then ()
  x :: xs then
    f(x)
    listApp(f)(xs)

private fun listExists(p)(l) = if l is
  Nil then false
  x :: xs then p(x) || listExists(p)(xs)

private fun fillArray(arr, i, n, x) = if i == n then arr else
  set arr.[i] = x
  fillArray(arr, i + 1, n, x)

// the 3cps primitive
private fun array_alloc(n, init) = fillArray(mut [], 0, n, init)


// basis library

private fun intToString(n) = ""

private fun intMin(a, b) = if a < b then a else b

private fun not_(b) = if b is
  false then true
  true then false


// start program code

private fun print_(s) = ()

private fun doo(max, f) =
  fun loop(i) = if i >= max then () else
    f(i)
    loop(i + 1)
  loop(0)

private fun zero(x) = x == 0

private fun cons(x, xs) = x :: xs

private fun make_vector(n, init) = if n > 0 then array_alloc(n, init)

private fun vector_length(v) = v.length

private fun vector_ref(v, i) = v![i]

private fun vector_set(v, i, x) = set v![i] = x

private fun map_n_vector(n, f) = if n > 0 then
  let arr = array_alloc(n, f(0))
  fun init(i) =
    if i < n then
      vector_set(arr, i, f(i))
      init(i + 1)
    else ()
  init(1)
  arr

private fun string_length(s) = s.length

private fun string_ref(s, i) = s![i]

private fun write_char(c) = ()

private fun modulo(a, b) = a - b * floor(a / b)

private fun quotient(a, b) = floor(a / b)

private fun for_each(l, f) = listApp(f)(l)

private fun negative(x) = x < 0

private fun positive(x) = x > 0

private fun min(l) = if l is x :: l1 then
  fun loop(l, min) = if l is
    Nil then min
    x :: l2 then loop(l2, intMin(min, x))
  loop(l1, x)

private fun every_n(n, p) =
  fun loop(i) = i >= n || (p(i) && loop(i + 1))
  loop(0)

private fun some(l, p) = listExists(p)(l)

private fun some_vector(v, p) =
  fun loop(i) = i < vector_length(v) && (p(vector_ref(v, i)) || loop(i + 1))
  loop(0)

private fun px(p) = if p is [x, _] then x

private fun py(p) = if p is [_, y] then y

data class Matrix(a)

private fun make_matrix(m, n, a) = Matrix(map_n_vector(m, i => make_vector(n, a)))

private fun matrix_rows(mat) = if mat is Matrix(a) then vector_length(a)

private fun matrix_columns(mat) = if mat is Matrix(a) then vector_length(vector_ref(a, 0))

private fun matrix_ref(mat, i, j) = if mat is Matrix(a) then vector_ref(vector_ref(a, i), j)

private fun matrix_set(mat, i, j, x) = if mat is Matrix(a) then vector_set(vector_ref(a, i), j, x)

data class PInt(n)
data class PString(s)

private fun pormat(control_string, values) =
  fun loop(i, values) =
    if not_(i == string_length(control_string)) then
      let c = string_ref(control_string, i)
      if c == "~" then
        let c2 = string_ref(control_string, i + 1)
        if
          c2 == "s" and values is PInt(n) :: values1 then
            print_(intToString(n))
            loop(i + 2, values1)
          c2 == "a" and values is PString(s) :: values1 then
            print_(s)
            loop(i + 2, values1)
          c2 == "%" then
            print_("\n")
            loop(i + 2, values)
          else
            write_char(c)
            loop(i + 1, values)
      else
        write_char(c)
        loop(i + 1, values)
    else ()
  loop(0, values)

// the vertices are s, t, and (y,x).
// C_RIGHT[y,x] is the capacity from (y,x) to (y,x+1) which is the same as the
// capacity from (y,x+1) to (y,x).
// C_DOWN[y,x] is the capacity from (y,x) to (y+1,x) which is the same as the
// capacity from (y+1,x) to (y,x).
// the capacity from s to (y,0), (0,x), (y,Y_1), (0,X_1) is implicitly infinite.
// the capacity from (x,y) to t is V*W[y,x].
// F_RIGHT[y,x] is the preflow from (y,x) to (y,x+1) which is the negation of
// the preflow from (y,x+1) to (y,x).
// F_DOWN[y,x] is the preflow from (y,x) to (y+1,x) which is the negation of
// the preflow from (y+1,x) to (y,x).
// we do not record the preflow from s to (y,X_1), (y,0), (Y_1,x), and (0,x)
// and from (y,X_1), (y,0), (Y_1,x), and (0,x) to s.
// F_T[y,x] is the preflow from (y,x) to t.
// we do not record the preflow from t to (y,x).
// {C,F}_RIGHT[0:Y_1,0:X_2].
// {C,F}_DOWN[0:Y_2,0:X_1].
// F_T[0:Y_1,0:X_1]
// for now, we will keep all capacities (and thus all preflows) as integers.
// (CF_RIGHT y x) is the residual capacity from (y,x) to (y,x+1).
// (CF_LEFT y x) is the residual capacity from (y,x) to (y,x_1).
// (CF_DOWN y x) is the residual capacity from (y,x) to (y+1,x).
// (CF_UP y x) is the residual capacity from (y,x) to (y_1,x).
// we do not compute the residual capacities from s to (y,X_1), (y,0),
// (Y_1,x), and (0,x) because they are all infinite.
// we do not compute the residual capacities from (y,X_1), (y,0), (Y_1,x),
// and (0,x) to s because they will never be used.
// (CF_T y x) is the residual capacity from (y,x) to t.
// we do not compute the residual capacity from t to (y,x) because it will be used.
// (EF_RIGHT? y x) is true if there is an edge from (y,x) to (y,x+1) in the residual network.
// (EF_LEFT? y x) is true if there is an edge from (y,x) to (y,x_1) in the residual network.
// (EF_DOWN? y x) is true if there is an edge from (y,x) to (y+1,x) in the residual network.
// (EF_UP? y x) is true if there is an edge from (y,x) to (y_1,x) in the residual network.
// (EF_T? y x) is true if there is an edge from (y,x) to t in the residual network.
// there are always edges in the residual network from s to (y,X_1), (y,0), (Y_1,x), and (0,x).
// we don't care whether there are edges in the residual network from
// (y,X_1), (y,0), (Y_1,x), and (0,x) to s because they will never be used.
// we don't care whether there are edges in the residual network from t to
// (y,x) because they will never be used.

private fun positive_min(x, y) = if negative(x) then y else intMin(x, y)

private fun positive_minus(x, y) = if negative(x) then x else x - y

private fun positive_plus(x, y) = if negative(x) then x else x + y

object QNil
data class QCons(head, rest)

private fun rao_ratio_region(c_right, c_down, w, lg_max_v) =
  let height = matrix_rows(w)
  let width = matrix_columns(w)
  let f_right = make_matrix(height, width - 1, 0)
  let f_down = make_matrix(height - 1, width, 0)
  let f_t = make_matrix(height, width, 0)
  let h = make_matrix(height, width, 0)
  let e = make_matrix(height, width, 0)
  let marked = make_matrix(height, width, false)
  let m1 = height * width + 2
  let m2 = 2 * height * width + 2
  let q = make_vector(2 * height * width + 3, Nil)
  fun cf_right(y, x) = matrix_ref(c_right, y, x) - matrix_ref(f_right, y, x)
  fun cf_left(y, x) = matrix_ref(c_right, y, x - 1) + matrix_ref(f_right, y, x - 1)
  fun cf_down(y, x) = matrix_ref(c_down, y, x) - matrix_ref(f_down, y, x)
  fun cf_up(y, x) = matrix_ref(c_down, y - 1, x) + matrix_ref(f_down, y - 1, x)
  fun ef_right(y, x) = positive(cf_right(y, x))
  fun ef_left(y, x) = positive(cf_left(y, x))
  fun ef_down(y, x) = positive(cf_down(y, x))
  fun ef_up(y, x) = positive(cf_up(y, x))
  fun preflow_push(v) =
    fun enqueue(y, x) =
      if not_(matrix_ref(marked, y, x)) then
        vector_set(q, matrix_ref(h, y, x), cons([x, y], vector_ref(q, matrix_ref(h, y, x))))
        matrix_set(marked, y, x, true)
      else ()
    fun cf_t(y, x) = v * matrix_ref(w, y, x) - matrix_ref(f_t, y, x)
    fun ef_t(y, x) = positive(cf_t(y, x))
    fun can_push_right(y, x) =
      x < width - 1 && not_(zero(matrix_ref(e, y, x))) && ef_right(y, x) && matrix_ref(h, y, x) == matrix_ref(h, y, x + 1) + 1
    fun can_push_left(y, x) =
      x > 0 && not_(zero(matrix_ref(e, y, x))) && ef_left(y, x) && matrix_ref(h, y, x) == matrix_ref(h, y, x - 1) + 1
    fun can_push_down(y, x) =
      y < height - 1 && not_(zero(matrix_ref(e, y, x))) && ef_down(y, x) && matrix_ref(h, y, x) == matrix_ref(h, y + 1, x) + 1
    fun can_push_up(y, x) =
      y > 0 && not_(zero(matrix_ref(e, y, x))) && ef_up(y, x) && matrix_ref(h, y, x) == matrix_ref(h, y - 1, x) + 1
    fun can_push_t(y, x) =
      not_(zero(matrix_ref(e, y, x))) && ef_t(y, x) && matrix_ref(h, y, x) == 1
    fun can_lift(y, x) =
      not_(zero(matrix_ref(e, y, x))) &&
        (if x == width - 1 then matrix_ref(h, y, x) <= m1
        else (not_(ef_right(y, x)) || matrix_ref(h, y, x) <= matrix_ref(h, y, x + 1))) &&
        (if x == 0 then matrix_ref(h, y, x) <= m1
        else (not_(ef_left(y, x)) || matrix_ref(h, y, x) <= matrix_ref(h, y, x - 1))) &&
        (if y == height - 1 then matrix_ref(h, y, x) <= m1
        else (not_(ef_down(y, x)) || matrix_ref(h, y, x) <= matrix_ref(h, y + 1, x))) &&
        (if y == 0 then matrix_ref(h, y, x) <= m1
        else (not_(ef_up(y, x)) || matrix_ref(h, y, x) <= matrix_ref(h, y - 1, x))) &&
        (not_(ef_t(y, x)) || matrix_ref(h, y, x) == 0)
    fun push_right(y, x) =
      let df_u_v = positive_min(matrix_ref(e, y, x), cf_right(y, x))
      matrix_set(f_right, y, x, matrix_ref(f_right, y, x) + df_u_v)
      matrix_set(e, y, x, positive_minus(matrix_ref(e, y, x), df_u_v))
      matrix_set(e, y, x + 1, positive_plus(matrix_ref(e, y, x + 1), df_u_v))
      enqueue(y, x + 1)
    fun push_left(y, x) =
      let df_u_v = positive_min(matrix_ref(e, y, x), cf_left(y, x))
      matrix_set(f_right, y, x - 1, matrix_ref(f_right, y, x - 1) - df_u_v)
      matrix_set(e, y, x, positive_minus(matrix_ref(e, y, x), df_u_v))
      matrix_set(e, y, x - 1, positive_plus(matrix_ref(e, y, x - 1), df_u_v))
      enqueue(y, x - 1)
    fun push_down(y, x) =
      let df_u_v = positive_min(matrix_ref(e, y, x), cf_down(y, x))
      matrix_set(f_down, y, x, matrix_ref(f_down, y, x) + df_u_v)
      matrix_set(e, y, x, positive_minus(matrix_ref(e, y, x), df_u_v))
      matrix_set(e, y + 1, x, positive_plus(matrix_ref(e, y + 1, x), df_u_v))
      enqueue(y + 1, x)
    fun push_up(y, x) =
      let df_u_v = positive_min(matrix_ref(e, y, x), cf_up(y, x))
      matrix_set(f_down, y - 1, x, matrix_ref(f_down, y - 1, x) - df_u_v)
      matrix_set(e, y, x, positive_minus(matrix_ref(e, y, x), df_u_v))
      matrix_set(e, y - 1, x, positive_plus(matrix_ref(e, y - 1, x), df_u_v))
      enqueue(y - 1, x)
    fun push_t(y, x) =
      let df_u_v = positive_min(matrix_ref(e, y, x), cf_t(y, x))
      matrix_set(f_t, y, x, matrix_ref(f_t, y, x) + df_u_v)
      matrix_set(e, y, x, positive_minus(matrix_ref(e, y, x), df_u_v))
    fun lift(y, x) = matrix_set(h, y, x, 1 + min(
      (if x == width - 1 then m1 else if ef_right(y, x) then matrix_ref(h, y, x + 1) else m2) ::
      (if x == 0 then m1 else if ef_left(y, x) then matrix_ref(h, y, x - 1) else m2) ::
      (if y == height - 1 then m1 else if ef_down(y, x) then matrix_ref(h, y + 1, x) else m2) ::
      (if y == 0 then m1 else if ef_up(y, x) then matrix_ref(h, y - 1, x) else m2) ::
      (if ef_t(y, x) then 0 else m2) ::
      Nil))
    fun relabel() =
      fun isNull(q) = if q.Ref#value is
        QNil then true
        else false
      let q = new mut Ref(QNil)
      let tail = new mut Ref(QNil)
      fun enqueue(y, x, value) =
        if value < matrix_ref(h, y, x) then
          matrix_set(h, y, x, value)
          if not_(matrix_ref(marked, y, x)) then
            matrix_set(marked, y, x, true)
            (if tail.Ref#value is
              QNil then
                set tail.Ref#value = QCons([x, y], new mut Ref(QNil))
                set q.Ref#value = tail.Ref#value
              QCons(_, cdr) then
                set cdr.Ref#value = QCons([x, y], new mut Ref(QNil))
                set tail.Ref#value = cdr.Ref#value)
          else ()
        else ()
      fun dequeue() = if q.Ref#value is QCons(p, rest) then
        matrix_set(marked, py(p), px(p), false)
        set q.Ref#value = rest.Ref#value
        if isNull(q) then
          set tail.Ref#value = QNil
        else ()
        p
      doo(height, y => doo(width, x =>
        matrix_set(h, y, x, m1)
        matrix_set(marked, y, x, false)))
      doo(height, y => doo(width, x =>
        if ef_t(y, x) && matrix_ref(h, y, x) > 1 then enqueue(y, x, 1) else ()))
      fun loop() =
        if not_(isNull(q)) then
          let p = dequeue()
          let x = px(p)
          let y = py(p)
          let value = matrix_ref(h, y, x) + 1
          if x > 0 && ef_right(y, x - 1) then enqueue(y, x - 1, value) else ()
          if x < width - 1 && ef_left(y, x + 1) then enqueue(y, x + 1, value) else ()
          if y > 0 && ef_down(y - 1, x) then enqueue(y - 1, x, value) else ()
          if y < height - 1 && ef_up(y + 1, x) then enqueue(y + 1, x, value) else ()
          loop()
        else ()
      loop()
    doo(height, y => doo(width, x =>
      matrix_set(e, y, x, 0)
      matrix_set(f_t, y, x, 0)))
    doo(height, y => doo(width - 1, x => matrix_set(f_right, y, x, 0)))
    doo(height - 1, y => doo(width, x => matrix_set(f_down, y, x, 0)))
    doo(height, y =>
      matrix_set(e, y, width - 1, -1)
      matrix_set(e, y, 0, -1))
    doo(width - 1, x =>
      matrix_set(e, height - 1, x, -1)
      matrix_set(e, 0, x, -1))
    let pushes = new mut Ref(0)
    let lifts = new mut Ref(0)
    let relabels = new mut Ref(0)
    fun loop(i, p) =
      if zero(modulo(i, 6)) && not_(p) then
        relabel()
        set relabels.Ref#value = relabels.Ref#value + 1
        if every_n(height, y => every_n(width, x => zero(matrix_ref(e, y, x)) || matrix_ref(h, y, x) == m1)) then
          // every vertex with excess capacity is not reachable from the sink in the inverse residual
          // network, so terminate early because we have already found a min cut (see the original for
          // why early termination is necessary with relabeling)
          pormat(
            "~s push~a, ~s lift~a, ~s relabel~a, ~s wave~a, terminated early~%",
            PInt(pushes.Ref#value) :: PString(if pushes.Ref#value == 1 then "" else "es") ::
            PInt(lifts.Ref#value) :: PString(if lifts.Ref#value == 1 then "" else "s") ::
            PInt(relabels.Ref#value) :: PString(if relabels.Ref#value == 1 then "" else "s") ::
            PInt(i) :: PString(if i == 1 then "" else "s") :: Nil)
        else
          // we need to rebuild the priority queue after relabeling since the heights might have changed
          // and the priority queue is indexed by height; this also assumes that a relabel is done before
          // any pushes or lifts
          doo(vector_length(q), k => vector_set(q, k, Nil))
          doo(height, y => doo(width, x => matrix_set(marked, y, x, false)))
          doo(height, y => doo(width, x => if not_(zero(matrix_ref(e, y, x))) then enqueue(y, x) else ()))
          loop(i, true)
      else if some_vector(q, ps => some(ps, p =>
          let x = px(p)
          let y = py(p)
          can_push_right(y, x) || can_push_left(y, x) || can_push_down(y, x) || can_push_up(y, x) || can_push_t(y, x) || can_lift(y, x))) then
        fun loopK(k) =
          if not_(negative(k)) then
            let ps = vector_ref(q, k)
            vector_set(q, k, Nil)
            for_each(ps, p => matrix_set(marked, py(p), px(p), false))
            for_each(ps, p =>
              let x = px(p)
              let y = py(p)
              if can_push_right(y, x) then
                set pushes.Ref#value = pushes.Ref#value + 1
                push_right(y, x)
              else ()
              if can_push_left(y, x) then
                set pushes.Ref#value = pushes.Ref#value + 1
                push_left(y, x)
              else ()
              if can_push_down(y, x) then
                set pushes.Ref#value = pushes.Ref#value + 1
                push_down(y, x)
              else ()
              if can_push_up(y, x) then
                set pushes.Ref#value = pushes.Ref#value + 1
                push_up(y, x)
              else ()
              if can_push_t(y, x) then
                set pushes.Ref#value = pushes.Ref#value + 1
                push_t(y, x)
              else ()
              if can_lift(y, x) then
                set lifts.Ref#value = lifts.Ref#value + 1
                lift(y, x)
              else ()
              if not_(zero(matrix_ref(e, y, x))) then enqueue(y, x) else ())
            loopK(k - 1)
          else ()
        loopK(vector_length(q) - 1)
        loop(i + 1, false)
      else
        // this is so MIN_CUT and MIN_CUT_INCLUDES_EVERY_EDGE_TO_T work
        relabel()
        set relabels.Ref#value = relabels.Ref#value + 1
        pormat(
          "~s push~a, ~s lift~a, ~s relabel~a, ~s wave~a~%",
          PInt(pushes.Ref#value) :: PString(if pushes.Ref#value == 1 then "" else "es") ::
          PInt(lifts.Ref#value) :: PString(if lifts.Ref#value == 1 then "" else "s") ::
          PInt(relabels.Ref#value) :: PString(if relabels.Ref#value == 1 then "" else "s") ::
          PInt(i) :: PString(if i == 1 then "" else "s") :: Nil)
    loop(0, false)
  // this requires that a relabel was done immediately before returning from PREFLOW_PUSH
  fun min_cut_includes_every_edge_to_t() =
    every_n(height, y => every_n(width, x => matrix_ref(h, y, x) == m1))
  // this requires that a relabel was done immediately before returning from PREFLOW_PUSH
  fun min_cut() =
    map_n_vector(height, y => map_n_vector(width, x => not_(matrix_ref(h, y, x) == m1)))
  fun loop(lg_v, v_max) =
    if negative(lg_v) then
      pormat("V-MAX=~s~%", PInt(v_max) :: Nil)
      preflow_push(v_max + 1)
      min_cut()
    else
      fun loopPow(i, c) = if zero(i) then c else loopPow(i - 1, c + c)
      let v = v_max + loopPow(lg_v, 1)
      pormat("LG-V=~s, V-MAX=~s, V=~s~%", PInt(lg_v) :: PInt(v_max) :: PInt(v) :: Nil)
      preflow_push(v)
      loop(lg_v - 1, if min_cut_includes_every_edge_to_t() then v else v_max)
  loop(lg_max_v, 0)

private fun doit(n) =
  let height = n
  let width = n
  let lg_max_v = 15
  let c_right = make_matrix(height, width - 1, -1)
  let c_down = make_matrix(height - 1, width, -1)
  doo(height, y => doo(width - 1, x =>
    matrix_set(c_right, y, x,
      if y >= quotient(height, 4) && y < quotient(3 * height, 4) && (x == quotient(width, 4) - 1 || x == quotient(3 * width, 4) - 1) then 1 else 128)))
  doo(height - 1, y => doo(width, x =>
    matrix_set(c_down, y, x,
      if x >= quotient(width, 4) && x < quotient(3 * width, 4) && (y == quotient(height, 4) - 1 || y == quotient(3 * height, 4) - 1) then 1 else 128)))
  rao_ratio_region(c_right, c_down, make_matrix(height, width, 1), lg_max_v)

fun main() = doit(5)
