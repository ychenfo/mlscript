#lang(0.3.x)

import "../../../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"

// bowling scorer on the tardis monad (forwards- and backwards-travelling state)
// source: webs artifact (zenodo 15050194), 3cps/test/programs/examples/tardis.sml,
// translated to sml by skye soss from the haskell `tardis` package
// port changes:
// - structure Tardis is flattened into top-level functions
// - the impossible `raise Fail` cases are left out (implicit match error)
// - type-check lines are dropped; `initialFw` moves into `score`
// - `main` returns `score(sampleGame)`; the nofib/sml/tardis diff test checks it against `expectedScore`
// - a `unit -> t` thunk takes no parameter, except where generic code passes `()`:
//   `bind`'s continuations and the function given to `fix` keep one parameter

module tardis with ...



data class (::) Cons(head, tail)
object Nil

data class Some(value)
object None

class Ref(val value)

private fun map(f)(l) = if l is
  Nil then Nil
  x :: l then f(x) :: map(f)(l)


private fun run(m, bw, fw) = m(bw, fw)

private fun pure(a)(bw, fw) = [a, bw, fw]

private fun getPast(bw, fw) = [fw, bw, fw]

private fun getFuture(bw, fw) = [bw, bw, fw]

private fun sendPast(bw)(bw0, fw) = [(), bw, fw]

private fun sendFuture(fw)(bw, fw0) = [(), bw, fw]

private fun bind(m)(f)(bw, fw) =
  let r = new mut Ref(None)
  fun getBw1() = if r.Ref#value is Some(bw1) then bw1()
  if m(getBw1, fw) is [x, bw2, fw1] and f(x)(bw, fw1) is [x1, bw1, fw2] then
    set r.Ref#value = Some(bw1)
    [x1, bw2, fw2]

private fun fix(f)(bw, fw) =
  let r = new mut Ref(None)
  fun get(a) = if r.Ref#value is Some(y) then y(a)
  if f(get)(bw, fw) is [x, bw1, fw1] then
    set r.Ref#value = Some(x)
    [x, bw1, fw1]


private fun fst(p) = if p is [a, b] then a
private fun snd(p) = if p is [a, b] then b

object Strike
data class Spare(firstThrow)
data class Frame(firstThrow, secondThrow)

data class LStrike(bonus1, bonus2)
data class LSpare(bonus1, throw1)
data class LFrame(throw1, throw2)

data class Game(frames, lastFrame)

private fun lframeScore(lastFrame) = if lastFrame is
  LStrike(bonus1, bonus2) then 10 + bonus1 + bonus2
  LSpare(bonus1, throw1) then 10 + bonus1
  LFrame(throw1, throw2) then throw1 + throw2

private fun initialBw(lastFrame)() = if lastFrame is
  LStrike(bonus1, bonus2) then [10, bonus1]
  LSpare(bonus1, throw1) then [throw1, 10 - throw1]
  LFrame(throw1, throw2) then [throw1, throw2]

private fun score(game) = if game is Game(frames, lastFrame) then
  let finalFrameScore = lframeScore(lastFrame)
  
  fun go(frames) = if frames is
    Nil then
      bind(getPast)(scores => if scores is score :: _ then
        pure((() => finalFrameScore + score()) :: scores))
    f :: fs then
      bind(fix(p =>
        let score1 = () => fst(p(()))()
        let throws1 = () => snd(p(()))
        bind(sendPast(throws1))(_ =>
          bind(getPast)(scores => if scores is score :: _ then
            bind(sendFuture(score1 :: scores))(_ =>
              bind(getFuture)(nextThrows =>
                if f is
                  Strike then pure(_ =>
                    [() => score() + 10 + fst(nextThrows()) + snd(nextThrows()), [10, fst(nextThrows())]])
                  Spare(firstThrow) then pure(_ =>
                    [() => score() + 10 + fst(nextThrows()), [firstThrow, 10 - firstThrow]])
                  Frame(firstThrow, secondThrow) then pure(_ =>
                    [() => score() + firstThrow + secondThrow, [firstThrow, secondThrow]])))))))(_ => go(fs))
  
  let initialFw = (() => 0) :: Nil
  if run(go(frames), initialBw(lastFrame), initialFw) is [scores, bw, fw] then
    map(th => th())(scores)

fun main() =
  let sampleGame = Game(
    Strike :: Spare(9) :: Strike :: Strike :: Strike :: Frame(8, 1) :: Spare(7) :: Strike :: Strike :: Nil,
    LStrike(10, 10))
  score(sampleGame)
