import "../../../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
import "./NofibPrelude.mls"
open Predef
open NofibPrelude


module ArrayOps with ...

fun zip3Arr(arr1, arr2, arr3) =
  let len = Math.min(arr1.length, arr2.length, arr3.length)
  let result = Array(len)
  let i = 0
  while i < len do
    set result.[i] = [arr1.[i], arr2.[i], arr3.[i]]
    set i += 1
  result

fun zipArr(arr1, arr2) =
  let len = Math.min(arr1.length, arr2.length)
  let result = Array(len)
  let i = 0
  while i < len do
    set result.[i] = [arr1.[i], arr2.[i]]
    set i += 1
  result

fun scanlArr(f, init, arr) =
  let result = Array(arr.length + 1)
  set result.[0] = init
  let i = 0
  while i < arr.length do
    set result.[i + 1] = f(result.[i], arr.[i])
    set i += 1
  result

fun mapArr(f, arr) =
  let result = Array(arr.length)
  let i = 0
  while i < arr.length do
    set result.[i] = f(arr.[i])
    set i += 1
  result

fun takeArr(n, arr) = arr.slice(0, n)

fun leaveArr(n, arr) = arr.slice(n, arr.length)

fun arrToList(arr) =
  let res = Nil
  let i = arr.length - 1
  while i >= 0 do
    set res = arr.[i] :: res
    set i -= 1
  res

fun enumFromThenToArr(a, step, b) =
  let len = if step >= a then Math.max(0, Math.floor((b - a) / (step - a)) + 1) else Math.max(0, Math.floor((a - b) / (a - step)) + 1)
  let result = Array(len)
  let i = 0
  while i < len do
    set result.[i] = a + i * (step - a)
    set i += 1
  result

fun enumFromToArr(a, b) =
  let len = b - a + 1
  let result = Array(len)
  let i = 0
  while i < len do
    set result.[i] = a + i
    set i += 1
  result

fun reverseArr(arr) =
  let result = Array(arr.length)
  let i = 0
  while i < arr.length do
    set result.[i] = arr.[arr.length - 1 - i]
    set i += 1
  result

fun inArr(x, arr) =
  let i = 0
  let found = false
  while (i < arr.length) && (not found) do
    if arr.[i] == x do
      set found = true
    set i += 1
  found

fun consArrInPlace(x, arr) =
  arr.unshift(x)
  arr


fun take_lz_Arr(n, ls) = if
  n > 0 and force(ls) is
    LzNil then Array(0)
    LzCons(h, t) then consArrInPlace(h, take_lz_Arr(n - 1, t))
  else Array(0)

fun maximumArr(xs) =
  let maxVal = xs.[0]
  let i = 1
  while i < xs.length do
    if xs.[i] > maxVal do
      set maxVal = xs.[i]
    set i += 1
  maxVal


fun leaveWhileArr(f, ls) =
  let i = 0
  while (i < ls.length) && f(ls.[i]) do
    set i += 1
  
  ls.slice(i, ls.length)

fun arrEq(arr1, arr2) =
  if arr1.length != arr2.length then false
  else
    let i = 0
    let eq = true
    while (i < arr1.length) && eq do
      if arr1.[i] != arr2.[i] do
        set eq = false
      set i += 1
    eq

fun filterArr(p, arr) =
  let res = Array(0)
  let i = 0
  while i < arr.length do
    if p(arr.[i]) do
      res.push(arr.[i])
    set i += 1
  res

fun stringToArray(s) = Array.from(s)

fun foldlArr(f, init, arr) =
  let acc = init
  let i = 0
  while i < arr.length do
    set acc = f(acc, arr.[i])
    set i += 1
  acc

fun appendedArr(arr1, arr2) =
  let result = Array(arr1.length + arr2.length)
  let i = 0
  while i < arr1.length do
    set result.[i] = arr1.[i]
    set i += 1
  let j = 0
  while j < arr2.length do
    set result.[i + j] = arr2.[j]
    set j += 1
  result


fun concatArr(arrOfArrs) =
  let totalLen = foldlArr((acc, arr) => acc + arr.length, 0, arrOfArrs)
  let result = Array(totalLen)
  let i = 0
  let pos = 0
  while i < arrOfArrs.length do
    let arr = arrOfArrs.[i]
    let j = 0
    while j < arr.length do
      set result.[pos] = arr.[j]
      set pos += 1
      set j += 1
    set i += 1
  result
