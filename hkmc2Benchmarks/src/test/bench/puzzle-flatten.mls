//│ ————————————————————————————————————————————————————————————————————————————————
module puzzle_flatten_2 with

  abstract class List5[out T1, T2, T3, T4, T5]: Cons2[T1, T2, T3, T4, T5] | Nil2
  data class Cons5[out T1, T2, T3, T4, T5](head1: T1, head2: T2, head3: T3, head4: T4, head5: T5, tail: List5[T1, T2, T3, T4, T5]) extends List5[T1, T2, T3, T4, T5]
  object Nil5 extends List5
  
  fun all5(f, ls) = if
    ls is
      Nil5 then true
      Cons5(a, b, c, d, e, t) and
        f(a, b, c, d, e) then all5(f, t)
        else false
  
  fun foldr5(f, r, ls) = if ls is
    Nil5 then r
    Cons5(a, b, c, d, e, t) then f(a, b, c, d, e, foldr5(f, r, t))
  
  abstract class ItemType: Bono | Edge | Larry | Adam

  object
    Bono extends ItemType
    Edge extends ItemType
    Larry extends ItemType
    Adam extends ItemType

  fun itemEq(a, b) = if a is
    Bono and b is Bono then true
    Edge and b is Edge then true
    Larry and b is Larry then true
    Adam and b is Adam then true
    else false

  fun succItem(i) = if i is
    Bono then Edge
    Edge then Larry
    Larry then Adam

  fun isEnd(i) = if i is
    Bono then false
    Edge then false
    Larry then false
    Adam then true

  fun itemFromTo(a, b) = if itemEq(a, b) then a :: Nil else a :: itemFromTo(succItem(a), b)

  abstract class BankType: LeftBank | RightBank

  object
    LeftBank extends BankType
    RightBank extends BankType

  fun bankEq(a, b) = if a is
    LeftBank and b is LeftBank then true
    RightBank and b is RightBank then true
    else false

  data class State(b: BankType, e: BankType, l: BankType, a: BankType)

  fun stateEq(a, b, c, d, e, f, g, h) =
    (bankEq(a, e) && bankEq(b, f) && bankEq(c, g) && bankEq(d, h))

  fun bonoPos(a, b, c, d) = a

  fun edgePos(a, b, c, d) = b

  fun larryPos(a, b, c, d) = c

  fun adamPos(a, b, c, d) = d

  val initialState = State(LeftBank, LeftBank, LeftBank, LeftBank)
  //│ initialState = State(LeftBank, LeftBank, LeftBank, LeftBank)

  val finalState = State(RightBank, RightBank, RightBank, RightBank)
  //│ finalState = State(RightBank, RightBank, RightBank, RightBank)

  fun position(i, a, b, c, d) = if i is
    Bono then bonoPos(a, b, c, d)
    Edge then edgePos(a, b, c, d)
    Larry then larryPos(a, b, c, d)
    Adam then adamPos(a, b, c, d)

  // fun updateState(a, b, c, d, i, pos) = if i is
  //   Bono then State(pos, b, c, d)
  //   Edge then State(a, pos, c, d)
  //   Larry then State(a, b, pos, d)
  //   Adam then State(a, b, c, pos)

  fun opposite(b) = if b is
    LeftBank then RightBank
    RightBank then LeftBank

  fun notSeen(a, b, c, d, states) =
    all5((_x, sa, sb, sc, sd) => not(stateEq(a, b, c, d, sa, sb, sc, sd)), states)

  fun writeItem(i, b, rest) = if i is
    Bono and b is LeftBank then nofibStringToList("    Bono |                    |\n") +: rest
    Edge and b is LeftBank then nofibStringToList("The Edge |                    |\n") +: rest
    Larry and b is LeftBank then nofibStringToList("   Larry |                    |\n") +: rest
    Adam and b is LeftBank then nofibStringToList("    Adam |                    |\n") +: rest
    Bono and b is RightBank then nofibStringToList("         |                    | Bono\n") +: rest
    Edge and b is RightBank then nofibStringToList("         |                    | The Edge\n") +: rest
    Larry and b is RightBank then nofibStringToList("         |                    | Larry\n") +: rest
    Adam and b is RightBank then nofibStringToList("         |                    | Adam\n") +: rest

  fun writeState(a, b, c, d, s) =
    nofibStringToList("----------------------------------------\n") +:
    writeItem of
      Bono
      bonoPos(a, b, c, d)
      writeItem of
        Edge
        edgePos(a, b, c, d)
        writeItem of
          Larry
          larryPos(a, b, c, d)
          writeItem of
            Adam
            adamPos(a, b, c, d)
            nofibStringToList("----------------------------------------\n") +: s

  fun totalTime(history) = if history is Cons5(time, _, _, _, _, _) then time

  fun writeHistory(history, x) = if history is
    Nil then x
    else
      foldr5(
        (time, sa, sb, sc, sd, acc) => (s) =>
          nofibStringToList("Time: ") +: nofibStringToList(stringOfInt(totalTime(history) - time)) +: ("\n" :: writeState(sa, sb, sc, sd, acc(s))),
        x => x,
        history
      )(x)

  fun writeSolutions(solutions, count, s) = if solutions is
    Nil then s
    item :: next then
      nofibStringToList("Solution ") +:
      nofibStringToList(stringOfInt(count)) +:
      "\n" :: writeHistory(item, writeSolutions(next, count + 1, s))

  fun minSolutions(history) = if history is
    Nil then Nil
    history :: next then
      fun minAcc(minSoFar, mins, ls) = if ls is
        Nil then mins
        history :: next then
          let total = totalTime(history)
          if
            minSoFar < total then minAcc(minSoFar, mins, next)
            minSoFar === total then minAcc(minSoFar, history :: mins, next)
            else minAcc(total, history :: Nil, next)
      reverse(minAcc(totalTime(history), history :: Nil, next))

  fun u2times(i) = if i is
    Bono then 10
    Edge then 5
    Larry then 2
    Adam then 1

  fun transfer(sa, sb, sc, sd, da, db, dc, dd, location, countdown, history) =
    if stateEq(sa, sb, sc, sd, da, db, dc, dd) then Cons5(countdown, da, db, dc, dd, history) :: Nil
    else
      let newHistory = Cons5(countdown, da, db, dc, dd, history)
      val newLocation = opposite(location)
      fun lscomp1(ls) = if ls is
        Nil then Nil
        item :: xs then
          if bankEq(position(item, da, db, dc, dd), location) then
            // let newDest = updateState(da, db, dc, dd, item, newLocation)
            let scrut = if item is
              Bono then notSeen(newLocation, db, dc, dd, history)
              Edge then notSeen(da, newLocation, dc, dd, history)
              Larry then notSeen(da, db, newLocation, dd, history)
              Adam then notSeen(da, db, dc, newLocation, history)
            if scrut then
              let newTime = countdown + u2times(item)
              if item is
                Bono then transfer(sa, sb, sc, sd, newLocation, db, dc, dd, newLocation, newTime, newHistory) :: lscomp1(xs)
                Edge then transfer(sa, sb, sc, sd, da, newLocation, dc, dd, newLocation, newTime, newHistory) :: lscomp1(xs)
                Larry then transfer(sa, sb, sc, sd, da, db, newLocation, dd, newLocation, newTime, newHistory) :: lscomp1(xs)
                Adam then transfer(sa, sb, sc, sd, da, db, dc, newLocation, newLocation, newTime, newHistory) :: lscomp1(xs)
            else lscomp1(xs)
          else lscomp1(xs)
      let moveOne = concat(lscomp1(itemFromTo(Bono, Adam)))
      fun lscomp2(ls) = if ls is
        Nil then Nil
        i :: xs then
          fun lscomp3(ls) = if ls is
            Nil then lscomp2(xs)
            j :: ys then
              if bankEq(position(i, da, db, dc, dd), location) and bankEq(position(j, da, db, dc, dd), location) then
                // let newDest = updateState(updateState(da, db, dc, dd, i, newLocation), j, newLocation)
                let scrut = if i is
                  Bono then
                    // updateState(newLocation, db, dc, dd, j, newLocation)
                    if j is
                      Bono then notSeen(newLocation, db, dc, dd, history)
                      Edge then notSeen(newLocation, newLocation, dc, dd, history)
                      Larry then notSeen(newLocation, db, newLocation, dd, history)
                      Adam then notSeen(newLocation, db, dc, newLocation, history)
                  Edge then
                    // updateState(da, newLocation, dc, dd, j, newLocation)
                    if j is
                      Bono then notSeen(newLocation, newLocation, dc, dd, history)
                      Edge then notSeen(da, newLocation, dc, dd, history)
                      Larry then notSeen(da, newLocation, newLocation, dd, history)
                      Adam then notSeen(da, newLocation, dc, newLocation, history)
                  Larry then
                    // updateState(da, db, newLocation, dd, j, newLocation)
                    if j is
                      Bono then notSeen(newLocation, db, newLocation, dd, history)
                      Edge then notSeen(da, newLocation, newLocation, dd, history)
                      Larry then notSeen(da, db, newLocation, dd, history)
                      Adam then notSeen(da, db, newLocation, newLocation, history)
                  Adam then
                    // updateState(da, db, dc, newLocation, j, newLocation)
                    if j is
                      Bono then notSeen(newLocation, db, dc, newLocation, history)
                      Edge then notSeen(da, newLocation, dc, newLocation, history)
                      Larry then notSeen(da, db, newLocation, newLocation, history)
                      Adam then notSeen(da, db, dc, newLocation, history)
                if scrut then
                  let newTime = countdown + u2times(i)
                  if i is
                    Bono then
                      if j is
                        Bono then transfer(sa, sb, sc, sd, newLocation, db, dc, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Edge then transfer(sa, sb, sc, sd, newLocation, newLocation, dc, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Larry then transfer(sa, sb, sc, sd, newLocation, db, newLocation, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Adam then transfer(sa, sb, sc, sd, newLocation, db, dc, newLocation, newLocation, newTime, newHistory) :: lscomp3(ys)
                    Edge then
                      if j is
                        Bono then transfer(sa, sb, sc, sd, newLocation, newLocation, dc, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Edge then transfer(sa, sb, sc, sd, da, newLocation, dc, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Larry then transfer(sa, sb, sc, sd, da, newLocation, newLocation, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Adam then transfer(sa, sb, sc, sd, da, newLocation, dc, newLocation, newLocation, newTime, newHistory) :: lscomp3(ys)
                    Larry then
                      if j is
                        Bono then transfer(sa, sb, sc, sd, newLocation, db, newLocation, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Edge then transfer(sa, sb, sc, sd, da, newLocation, newLocation, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Larry then transfer(sa, sb, sc, sd, da, db, newLocation, dd, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Adam then transfer(sa, sb, sc, sd, da, db, newLocation, newLocation, newLocation, newTime, newHistory) :: lscomp3(ys)
                    Adam then
                      if j is
                        Bono then transfer(sa, sb, sc, sd, newLocation, db, dc, newLocation, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Edge then transfer(sa, sb, sc, sd, da, newLocation, dc, newLocation, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Larry then transfer(sa, sb, sc, sd, da, db, newLocation, newLocation, newLocation, newTime, newHistory) :: lscomp3(ys)
                        Adam then transfer(sa, sb, sc, sd, da, db, dc, newLocation, newLocation, newTime, newHistory) :: lscomp3(ys)
                  // transfer(sa, sb, sc, sd, newDest, newLocation, newTime, newHistory) :: lscomp3(ys)
                else lscomp3(ys)
              else lscomp3(ys)
          lscomp3(itemFromTo(succItem(i), Adam))
      let moveTwo = concat(lscomp2(itemFromTo(Bono, Larry)))
      moveOne +: moveTwo

  fun testPuzzle_nofib(x) =
    let time = if listLen(x) === 1 then 0 else throw Error("puzzle expects exactly one argument")
    let solutions = transfer(LeftBank, LeftBank, LeftBank, LeftBank, RightBank, RightBank, RightBank, RightBank, RightBank, time, Nil5)
    let mins = minSolutions(solutions)
    writeSolutions(mins, 1, Nil)

  fun main() = nofibListToString(testPuzzle_nofib(2 :: Nil))
//│ ————————————————————————————————————————————————————————————————————————————————

:silent
suite.add of
  "flatten"
  () => puzzle_flatten_2.main()



suite |> runSuite
writeResults(suite, "puzzle-flatten.json")

