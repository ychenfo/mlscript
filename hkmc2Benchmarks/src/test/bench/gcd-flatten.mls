//│ ————————————————————————————————————————————————————————————————————————————————
module gcd_flatten_3 with
  abstract class List2[out T1, T2]: Cons2[T1, T2] | Nil2
  data class Cons2[out T1, T2](head1: T1, head2: T2, tail: List2[T1, T2]) extends List2[T1, T2]
  object Nil2 extends List2
  
  abstract class List3[out T1, T2, T3]: Cons3[T1, T2, T3] | Nil3
  data class Cons3[out T1, T2, T3](head1: T1, head2: T2, head3: T3, tail: List3[T1, T2, T3]) extends List3[T1, T2, T3]
  object Nil3 extends List3
  
  fun map2_specialize(ls2) = if ls2 is
    Cons2(h1, h2, t) then Cons3(h1, h2, gcdE(h1, h2), map2_specialize(t))
    Nil2 then Nil3
  
  fun map3(ls3, f) = if ls3 is
    Cons3(h1, h2, h3, t) then f(h1, h2, h3) :: map3(t, f)
    Nil3 then Nil

  fun g(u1, u2, u3, v1, v2, v3) =
    if
      v3 == 0 then [u3, u1, u2]
      else if
        quotRem(u3, v3) is [q, r] then
          g(v1, v2, v3, u1 - (q * v1), u2 - (q * v2), r)

  fun gcdE(x, y) = if 
    x == 0 then [y, 0, 1]
    else g(1, 0, x, 0, 1, y)

  fun max_(ls) = if ls is
    x :: Nil then x
    x :: y :: xs then if x < y then max_(y :: xs) else max_(x :: xs)
    _ then console.log(ls)


  fun test(d) =
    let ns = enumFromTo(5000, 5000 + d)
    let ms = enumFromTo(10000, 10000 + d)
    fun lscomp1(p1) = if p1 is
      Nil then Nil2
      h1 :: t1 then
        fun lscomp2(p2) = if p2 is
          Nil then lscomp1(t1)
          h2 :: t2 then Cons2(h1, h2, lscomp2(t2))
        lscomp2(ms)
    let tripls =
      map2_specialize(lscomp1(ns))
    let rs = map3(tripls, (d1, d2, gg_u_v) => if gg_u_v is [gg, u, v] then abs(gg + u + v))
    max_(rs)
  
  fun testGcd_nofib(x) = test(x)

  fun main() = testGcd_nofib(40)
//│ ————————————————————————————————————————————————————————————————————————————————



:silent
suite.add of
  "flatten_3"
  () => gcd_flatten_3.main()





suite |> runSuite
writeResults(suite, "gcd-flatten.json")
