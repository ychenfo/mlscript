//│ ————————————————————————————————————————————————————————————————————————————————
module lcss with ...

fun algb2(x, k0j1, k1j1, yss) = if yss is
  Nil then Nil
  [y, k0j] :: ys then
    let kjcurr = if x == y then k0j1 + 1 else max(k1j1, k0j)
    [y, kjcurr] :: algb2(x, k0j, kjcurr, ys)

fun algb1(xss, yss) = if xss is
  Nil then map(snd, yss)
  x :: xs then algb1(xs, algb2(x, 0, 0, yss))

fun algb(xs, ys) =
  fun listcomp_fun(listcomp_fun_para) = if listcomp_fun_para is
      listcomp_fun_ls_h :: listcomp_fun_ls_t then [listcomp_fun_ls_h, 0] :: listcomp_fun(listcomp_fun_ls_t)
      Nil then Nil

  0 :: algb1(xs, listcomp_fun(ys))


fun findk(k, km, m, ls) = if ls is
  Nil then km
  [x,y] :: xys then if (x + y) >= m then findk(k+1, k, x+y, xys) else findk(k+1, km, m, xys)

fun algc(m, n, xs, ys) = if
  ys is Nil then x => x
  xs is
    x :: Nil and
      inList(x, ys) then t => x :: t
      else x => x
  else
    let m2 = intDiv(m, 2)
    let xs1 = take(m2, xs)
    let xs2 = leave(m2, xs)
    let l1 = algb(xs1, ys)
    let l2 = reverse(algb(reverse(xs2), reverse(ys)))
    let k = findk(0, 0, -1, zip(l1, l2))
    compose(algc(m2, k, xs1, take(k, ys)), (algc(m-m2, n-k, xs2, leave(k, ys))))

fun lcss(xs, ys) = algc(listLen(xs), listLen(ys), xs, ys)(Nil)

fun lcssMain(a, b ,c, d, e, f) = lcss(enumFromThenTo(a,b,c), enumFromThenTo(d,e,f))

fun testLCSS_nofib(d) = lcssMain(1,2,60,30,31,90)

fun main() = testLCSS_nofib(0).toString()
//│ ————————————————————————————————————————————————————————————————————————————————

:silent
suite.add of
  "original"
  () => lcss.main()

:...
//│ ————————————————————————————————————————————————————————————————————————————————
module lcss_array with ...

fun algb2(x, k0j1, k1j1, yss) =
  let i = 0
  let k0j1_mut = k0j1
  let k1j1_mut = k1j1
  let result = Array(yss.length)
  while i < yss.length do
    let yk0j = yss.[i]
    if yk0j is [y, k0j] then
      let kjcurr = if x == y then k0j1_mut + 1 else Math.max(k1j1_mut, k0j)
      set result.[i] = [y, kjcurr]
      set k1j1_mut = kjcurr
      set k0j1_mut = k0j
    set i += 1
  result

fun algb1(xss, yss) =
  let i = 0
  let yss_mut = yss
  while i < xss.length do
    let x = xss.[i]
    set yss_mut = algb2(x, 0, 0, yss_mut)
    set i += 1
  mapArr(snd, yss_mut)

fun algb(xs, ys) = consArrInPlace(0, algb1(xs, mapArr(h => [h, 0], ys)))


fun findk(k, km, m, ls) =
  let i = 0
  let mut_k = k
  let mut_km = km
  let mut_m = m
  while i < ls.length do
    if ls.[i] is [x,y] then
      if (x + y) >= mut_m do
        set mut_km = mut_k
        set mut_k = mut_k + 1
        set mut_m = x + y
      else
        set mut_k = mut_k + 1
    set i += 1
  mut_km

fun algc(m, n, xs, ys) =
  if ys.length == 0 then x => x
  else
    if xs.length == 1 and
      inArr(xs.[0], ys) then t => xs.[0] :: t
      else x => x
    else
      let m2 = intDiv(m, 2)
      let xs1 = takeArr(m2, xs)
      let xs2 = leaveArr(m2, xs)
      let l1 = algb(xs1, ys)
      let l2 = reverseArr(algb(reverseArr(xs2), reverseArr(ys)))
      let k = findk(0, 0, -1, zipArr(l1, l2))
      compose(algc(m2, k, xs1, takeArr(k, ys)), (algc(m-m2, n-k, xs2, leaveArr(k, ys))))

fun lcss(xs, ys) = algc(xs.length, ys.length, xs, ys)(Nil)

fun lcssMain(a, b ,c, d, e, f) = lcss(enumFromThenToArr(a,b,c), enumFromThenToArr(d,e,f))

fun testLCSS_nofib(d) = lcssMain(1,2,60,30,31,90)

fun main() = testLCSS_nofib(0).toString()
//│ ————————————————————————————————————————————————————————————————————————————————

:silent
suite.add of
  "array"
  () => lcss_array.main()


suite |> runSuite
writeResults(suite, "lcss-array.json")


