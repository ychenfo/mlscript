:js

import "../mlscript-compile/Benchmark.mls"
open Benchmark

let suite = mkSuite()
//│ suite = Suite { name: undefined, options: {name: undefined} }

abstract class List[out T]: Cons[T] | Nil
data class (::) Cons[out T](head: T, tail: List[T]) extends List[T]
object Nil extends List

fun intQuot(a, b) = Math.trunc(a / b)
fun intRem(a, b) = a - (b * intQuot(a, b))
fun quotRem(a, b) = [intQuot(a, b), intRem(a, b)]

fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

fun abs(x) = Math.abs(x)

fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

:...
//│ ————————————————————————————————————————————————————————————————————————————————
module gcd with
  fun g(u1u2u3, v1v2v3) = if u1u2u3 is [u1, u2, u3] and v1v2v3 is [v1, v2, v3] then
    if
      v3 == 0 then [u3, u1, u2]
      else if
        quotRem(u3, v3) is [q, r] then
          g([v1, v2, v3], [u1 - (q * v1), u2 - (q * v2), r])

  fun gcdE(x, y) = if 
    x == 0 then [y, 0, 1]
    else g([1, 0, x], [0, 1, y])

  fun max_(ls) = if ls is
    x :: Nil then x
    x :: y :: xs then if x < y then max_(y :: xs) else max_(x :: xs)
    _ then console.log(ls)


  fun test(d) =
    let ns = enumFromTo(5000, 5000 + d)
    let ms = enumFromTo(10000, 10000 + d)
    fun lscomp1(p1) = if p1 is
      Nil then Nil
      h1 :: t1 then
        fun lscomp2(p2) = if p2 is
          Nil then lscomp1(t1)
          h2 :: t2 then [h1, h2] :: lscomp2(t2)
        lscomp2(ms)
    let tripls =
      map(case { [x, y] then [x, y, gcdE(x, y)] }, lscomp1(ns))
    let rs = map(case { [d1, d2, [gg, u, v]] then abs(gg + u + v) }, tripls)
    max_(rs)
  
  fun testGcd_nofib(x) = test(x)

  fun main() = testGcd_nofib(100)
//│ ————————————————————————————————————————————————————————————————————————————————


:silent
suite.add of
  "original"
  () => gcd.main()



fun enumFromToArr(a, b) =
  let result = Array(b - a + 1)
  let i = 0
  while i <= (b - a) do
    set result.[i] = a + i
    set i += 1
  result

fun mapArr(f, arr) =
  let result = Array(arr.length)
  let i = 0
  while i < arr.length do
    set result.[i] = f(arr.[i])
    set i += 1
  result

:...
//│ ————————————————————————————————————————————————————————————————————————————————
module gcd_array_1 with
  fun g(u1u2u3, v1v2v3) = if u1u2u3 is [u1, u2, u3] and v1v2v3 is [v1, v2, v3] then
    if
      v3 == 0 then [u3, u1, u2]
      else if
        quotRem(u3, v3) is [q, r] then
          g([v1, v2, v3], [u1 - (q * v1), u2 - (q * v2), r])

  fun gcdE(x, y) = if 
    x == 0 then [y, 0, 1]
    else g([1, 0, x], [0, 1, y])

  fun max_Arr(ls) =
    let maxVal = ls.[0]
    let i = 1
    while i < ls.length do
      if maxVal < ls.[i] do
        set maxVal = ls.[i]
      set i += 1
    maxVal


  fun test(d) =
    let ns = enumFromToArr(5000, 5000 + d)
    let ms = enumFromToArr(10000, 10000 + d)
    fun lscomp1Arr(p1) =
      let result = Array(0)
      let i = 0
      while i < p1.length do
        let h1 = p1.[i]
        fun lscomp2Arr(p2) =
          let j = 0
          while j < p2.length do
            let h2 = p2.[j]
            result.push([h1, h2])
            set j += 1
        lscomp2Arr(ms)
        set i += 1
      result
    let tripls =
      mapArr(case { [x, y] then [x, y, gcdE(x, y)] }, lscomp1Arr(ns))
    let rs = mapArr(case { [d1, d2, [gg, u, v]] then abs(gg + u + v) }, tripls)
    max_Arr(rs)
  
  fun testGcd_nofib(x) = test(x)

  fun main() = testGcd_nofib(100)
//│ ————————————————————————————————————————————————————————————————————————————————


