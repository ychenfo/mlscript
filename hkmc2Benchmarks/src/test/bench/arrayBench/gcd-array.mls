:...
//│ ————————————————————————————————————————————————————————————————————————————————
module gcd_array_2 with
  fun g(u1u2u3, v1v2v3) = if u1u2u3 is [u1, u2, u3] and v1v2v3 is [v1, v2, v3] then
    if
      v3 == 0 then [u3, u1, u2]
      else if
        quotRem(u3, v3) is [q, r] then
          g([v1, v2, v3], [u1 - (q * v1), u2 - (q * v2), r])

  fun gcdE(x, y) = if 
    x == 0 then [y, 0, 1]
    else g([1, 0, x], [0, 1, y])

  fun max_Arr(ls) =
    let maxVal = ls.[0]
    let i = 1
    while i < ls.length do
      if maxVal < ls.[i] do
        set maxVal = ls.[i]
      set i += 1
    maxVal

  fun test(d) =
    let ns = enumFromToArr(5000, 5000 + d)
    let ms = enumFromToArr(10000, 10000 + d)
    // arr comprehension
    let arrComp = Array(ns.length * ms.length)
    let i = 0
    let k = 0
    while i < ns.length do
      let h1 = ns.[i]
      let j = 0
      while j < ms.length do
        let h2 = ms.[j]
        set arrComp.[k] = [h1, h2]
        set k += 1
        set j += 1
      set i += 1
    // arr comprehension end
    let tripls =
      mapArr(case { [x, y] then [x, y, gcdE(x, y)] }, arrComp)
    let rs = mapArr(case { [d1, d2, [gg, u, v]] then abs(gg + u + v) }, tripls)
    max_Arr(rs)
  
  fun testGcd_nofib(x) = test(x)

  fun main() = testGcd_nofib(100)
//│ ————————————————————————————————————————————————————————————————————————————————


:silent
suite.add of
  "array"
  () => gcd_array_2.main()



suite |> runSuite
writeResults(suite, "gcd-array.json")


